---
import type { Locale } from '../lib/seo';
import SEO from '../components/SEO.astro';
import { getCanonicalUrl, getHreflangUrls, type SEOConfig } from '../lib/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import '../index.css';

interface Props {
  locale: Locale;
  seo: SEOConfig;
  structuredData?: any[];
  translationSlugs?: Record<Locale, string>;
}

const { locale, seo, structuredData = [], translationSlugs } = Astro.props;
const currentPath = Astro.url.pathname;
// Extract path without locale prefix, handle homepage correctly
let pathWithoutLocale = Astro.url.pathname.replace(`/${locale}`, '');
if (pathWithoutLocale === '' || pathWithoutLocale === '/') {
  pathWithoutLocale = '';
}
const canonical = (seo.canonical && seo.canonical.startsWith('http')) 
  ? seo.canonical 
  : getCanonicalUrl(locale, seo.canonical ? (seo.canonical.replace(`/${locale}`, '') || '/') : pathWithoutLocale);
const hreflangRaw = seo.hreflang || (seo as any).alternates || getHreflangUrls(
  pathWithoutLocale,
  seo.translationGroup
);

// Map locale codes to proper BCP-47 hreflang format
const hreflangMap: Record<Locale, string> = {
  pl: 'pl-PL',
  en: 'en-GB',
  uk: 'uk-UA',
  ru: 'ru-RU',
};

// Remap alternates keys from 2-letter locale codes to BCP-47 codes
const hreflang = hreflangRaw
  ? Object.fromEntries(
      Object.entries(hreflangRaw).map(([lang, url]) => [
        hreflangMap[lang as Locale] ?? lang,
        url,
      ])
    )
  : undefined;

// Map locale to HTML lang attribute format
const htmlLangMap: Record<Locale, string> = {
  pl: 'pl-PL',
  en: 'en-GB',
  uk: 'uk-UA',
  ru: 'ru-RU',
};

// Default OG image for pages that don't specify one
const defaultOgImage = 'https://gentlepiercing.pl/hero/hero-3.jpg';
const ogImage = seo.ogImage || defaultOgImage;
---

<!doctype html>
<html lang={htmlLangMap[locale]}>
  <head>
    <!-- Google tag (gtag.js) - Deferred for better performance -->
    <script is:inline>
      // Defer Google Analytics loading until after page load
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      
      // Load GA script after page is interactive
      if (document.readyState === 'complete') {
        loadGA();
      } else {
        window.addEventListener('load', loadGA);
      }
      
      function loadGA() {
        // Use requestIdleCallback if available, otherwise setTimeout
        if ('requestIdleCallback' in window) {
          requestIdleCallback(() => {
            const script = document.createElement('script');
            script.async = true;
            script.src = 'https://www.googletagmanager.com/gtag/js?id=G-5XNL50H7LN';
            document.head.appendChild(script);
            gtag('js', new Date());
            gtag('config', 'G-5XNL50H7LN');
          }, { timeout: 2000 });
        } else {
          setTimeout(() => {
            const script = document.createElement('script');
            script.async = true;
            script.src = 'https://www.googletagmanager.com/gtag/js?id=G-5XNL50H7LN';
            document.head.appendChild(script);
            gtag('js', new Date());
            gtag('config', 'G-5XNL50H7LN');
          }, 1000);
        }
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    
    <!-- Resource Hints -->
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.sanity.io" />
    <link rel="preconnect" href="https://booksy.com" crossorigin />
    <link rel="dns-prefetch" href="https://booksy.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    
    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <meta name="generator" content={Astro.generator} />
    
    <!-- Additional Meta Tags -->
    <meta name="theme-color" content="#3E588F" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=yes" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Gentle Piercing" />

    <!-- Optimized SEO Component -->
    <SEO 
      title={seo.title}
      description={seo.description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={seo.ogType}
      noindex={seo.noindex}
      language={locale}
      alternates={hreflang}
      schema={structuredData}
      articlePublishedTime={seo.articlePublishedTime}
      articleModifiedTime={seo.articleModifiedTime}
      articleAuthor={seo.articleAuthor}
      articleSection={seo.articleSection}
    />
  </head>
  <body>
    <div class="min-h-screen flex flex-col">
      <Header locale={locale} currentPath={currentPath}>
        <LanguageSwitch 
          slot="language-switch"
          locale={locale}
          currentPath={currentPath}
          translationSlugs={translationSlugs}
        />
      </Header>
      <main class="flex-grow">
        <slot />
      </main>
      <Footer locale={locale}>
        <LanguageSwitch 
          slot="language-switch"
          locale={locale}
          currentPath={currentPath}
          translationSlugs={translationSlugs}
        />
      </Footer>
    </div>
  </body>
</html>

