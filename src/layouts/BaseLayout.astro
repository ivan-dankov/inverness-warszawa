---
import type { Locale } from '../lib/seo';
import { getCanonicalUrl, getHreflangUrls, type SEOConfig } from '../lib/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import '../index.css';

interface Props {
  locale: Locale;
  seo: SEOConfig;
  structuredData?: any[];
  translationSlugs?: Record<Locale, string>;
}

const { locale, seo, structuredData = [], translationSlugs } = Astro.props;
const currentPath = Astro.url.pathname;
const canonical = seo.canonical || getCanonicalUrl(locale, Astro.url.pathname.replace(`/${locale}`, ''));
const hreflang = seo.hreflang || getHreflangUrls(
  Astro.url.pathname.replace(`/${locale}`, ''),
  seo.translationGroup
);
---

<!doctype html>
<html lang={locale}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-5XNL50H7LN"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-5XNL50H7LN');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    
    <!-- Resource Hints -->
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.sanity.io" />
    <link rel="preconnect" href="https://booksy.com" crossorigin />
    <link rel="dns-prefetch" href="https://booksy.com" />
    
    <!-- Font Preloading -->
    <link rel="preload" href="/fonts/poppins/poppins-500-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins/poppins-600-latin.woff2" as="font" type="font/woff2" crossorigin />
    
    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <meta name="generator" content={Astro.generator} />
    
    <!-- Additional Meta Tags -->
    <meta name="theme-color" content="#3E588F" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=yes" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Gentle Piercing" />

    <!-- Primary Meta Tags -->
    <title>{seo.title}</title>
    <meta name="title" content={seo.title} />
    <meta name="description" content={seo.description} />
    {seo.noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Canonical URL -->
    <link rel="canonical" href={canonical} />

    <!-- Hreflang Tags -->
    <link rel="alternate" hreflang="pl" href={hreflang.pl} />
    <link rel="alternate" hreflang="uk" href={hreflang.uk} />
    <link rel="alternate" hreflang="ru" href={hreflang.ru} />
    <link rel="alternate" hreflang="en" href={hreflang.en} />
    <link rel="alternate" hreflang="x-default" href={hreflang.pl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={seo.ogType || "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    {seo.ogImage && (
      <>
        <meta property="og:image" content={seo.ogImage} />
        <meta property="og:image:secure_url" content={seo.ogImage} />
        <meta property="og:image:type" content="image/webp" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={seo.title} />
      </>
    )}
    <meta property="og:site_name" content="Gentle Piercing" />
    <meta property="og:locale" content={locale === 'pl' ? 'pl_PL' : locale === 'uk' ? 'uk_UA' : locale === 'ru' ? 'ru_RU' : 'en_US'} />
    
    {/* Article-specific OG tags */}
    {seo.ogType === 'article' && (
      <>
        {seo.articlePublishedTime && (
          <meta property="article:published_time" content={seo.articlePublishedTime} />
        )}
        {seo.articleModifiedTime && (
          <meta property="article:modified_time" content={seo.articleModifiedTime} />
        )}
        {seo.articleAuthor && (
          <meta property="article:author" content={seo.articleAuthor} />
        )}
        {seo.articleSection && (
          <meta property="article:section" content={seo.articleSection} />
        )}
      </>
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@prokol_ushej_warszawa" />
    <meta name="twitter:creator" content="@prokol_ushej_warszawa" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    {seo.ogImage && <meta name="twitter:image" content={seo.ogImage} />}

    <!-- Structured Data (JSON-LD) -->
    {structuredData.map((data, index) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body>
    <div class="min-h-screen flex flex-col">
      <Header locale={locale} currentPath={currentPath}>
        <LanguageSwitch 
          slot="language-switch"
          locale={locale}
          currentPath={currentPath}
          translationSlugs={translationSlugs}
        />
      </Header>
      <main class="flex-grow">
        <slot />
      </main>
      <Footer locale={locale}>
        <LanguageSwitch 
          slot="language-switch"
          locale={locale}
          currentPath={currentPath}
          translationSlugs={translationSlugs}
        />
      </Footer>
    </div>
  </body>
</html>

