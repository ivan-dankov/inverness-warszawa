---
import ServicePageWrapper from "../../../components/ServicePageWrapper.astro";
import { siteMetadata, generateAlternates } from '../../../config/seo';
import { getServicePageSEO } from '../../../lib/seo';

const seoConfig = getServicePageSEO('ru', 'przekluwanie-uszu-dzieci-warszawa');

const seoData = {
  title: seoConfig.title,
  description: seoConfig.description,
  language: 'ru',
  canonical: 'https://gentlepiercing.pl/ru/uslugi/prokol-ushej-detyam-varshava',
  hreflang: generateAlternates('services.children'),
  ogImage: siteMetadata.defaultOgImage,
};
---

<ServicePageWrapper 
  locale="ru"
  serviceSlug="przekluwanie-uszu-dzieci-warszawa"
  relatedServices={[
    'przekluwanie-uszu-dorosli-warszawa',
    'przekluwanie-chrzastki-warszawa',
    'przekluwanie-uszu-z-dojazdem-warszawa',
  ]}
  seo={seoData}
/>
