---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteMetadata, generateLocalBusinessSchema, generateAlternates } from '../../config/seo';
import { getBreadcrumbSchema } from '../../lib/seo';
import { t } from '../../lib/translations';
import Contact from '../../components/Contact.astro';

const locale = 'ru';
const seo = {
  title: "Запись Онлайн | Gentle Piercing | ☎️ +48 573-818-260 | Мокотув Варшава",
  description: "📍 Ursynowska 10/1, Мокотув, Варшава ☎️ +48 573-818-260 🕐 Пн-Вс 10:00-20:00 🚇 Метро Wilanowska 12мин | Запись на прокол ушей Inverness Med онлайн через Booksy ✓",
  language: 'ru',
  canonical: siteMetadata.urls.contact.ru,
  hreflang: generateAlternates('contact'),
  ogImage: 'https://gentlepiercing.pl/hero/hero-studio.jpg',
};

const structuredData = [
  generateLocalBusinessSchema(locale),
  getBreadcrumbSchema([
    { name: 'Главная', url: siteMetadata.urls.base + '/ru' },
    { name: 'Контакти', url: seo.canonical },
  ]),
];
---

<BaseLayout locale={locale} seo={seo} structuredData={structuredData}>
  <div class="min-h-screen bg-background">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 max-w-6xl">
      <!-- Breadcrumb -->
      <nav class="mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center flex-wrap gap-x-2 gap-y-1 text-sm text-muted-foreground">
          <li>
            <a href={`/${locale}`} class="hover:text-primary transition-colors">
              {t(locale, 'breadcrumb.home')}
            </a>
          </li>
          <li class="flex items-center">
            <span class="mx-2">/</span>
            <span class="text-foreground font-medium">{t(locale, 'header.nav.contact')}</span>
          </li>
        </ol>
      </nav>

      <!-- Contact Section -->
      <Contact locale={locale} />
    </div>
  </div>
</BaseLayout>

