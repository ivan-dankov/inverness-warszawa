---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBreadcrumbSchema, getCanonicalUrl, getLocalizedPageUrl, getPageSEO, type Locale } from '../../lib/seo';
import { t } from '../../lib/translations';
import Aftercare from '../../components/Aftercare.astro';

const locale: Locale = 'ru';
const baseSeo = getPageSEO(locale, 'aftercare');
const seo = {
  ...baseSeo,
  canonical: getLocalizedPageUrl('aftercare', locale),
  hreflang: generateAlternates('aftercare'),
  ogImage: 'https://gentlepiercing.pl/hero/hero-3.jpg',
};

const structuredData = [
  getBreadcrumbSchema([
    { name: t(locale, 'breadcrumb.home'), url: getCanonicalUrl(locale, '') },
    { name: t(locale, 'header.nav.aftercare'), url: seo.canonical },
  ]),
];
---

<BaseLayout locale={locale} seo={seo} structuredData={structuredData}>
  <div class="min-h-screen bg-background">
    <Aftercare locale={locale} />
  </div>
</BaseLayout>

