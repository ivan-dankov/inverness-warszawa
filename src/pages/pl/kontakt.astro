---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteMetadata, generateLocalBusinessSchema, generateAlternates } from '../../config/seo';
import { getBreadcrumbSchema, getPageSEO } from '../../lib/seo';
import { t } from '../../lib/translations';
import Contact from '../../components/Contact.astro';

const locale = 'pl';
const baseSeo = getPageSEO(locale, 'contact');
const seo = {
  ...baseSeo,
  canonical: siteMetadata.urls.base + siteMetadata.urls.contact.pl,
  alternates: generateAlternates('contact'),
  ogImage: siteMetadata.defaultOgImage,
};

const structuredData = [
  generateLocalBusinessSchema(locale),
  getBreadcrumbSchema([
    { name: 'Strona Główna', url: siteMetadata.urls.base + '/pl' },
    { name: 'Kontakt', url: seo.canonical },
  ]),
];
---

<BaseLayout locale={locale} seo={seo} structuredData={structuredData}>
  <div class="min-h-screen bg-background">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 max-w-6xl">
      <!-- Breadcrumb -->
      <nav class="mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center flex-wrap gap-x-2 gap-y-1 text-sm text-muted-foreground">
          <li>
            <a href={`/${locale}`} class="hover:text-primary transition-colors">
              {t(locale, 'breadcrumb.home')}
            </a>
          </li>
          <li class="flex items-center">
            <span class="mx-2">/</span>
            <span class="text-foreground font-medium">{t(locale, 'header.nav.contact')}</span>
          </li>
        </ol>
      </nav>

      <!-- Contact Section -->
      <Contact locale={locale} />
    </div>
  </div>
</BaseLayout>

