---
import ServicePageWrapper from "../../../components/ServicePageWrapper.astro";
import { siteMetadata, generateAlternates } from '../../../config/seo';
import { getServicePageSEO } from '../../../lib/seo';

const seoConfig = getServicePageSEO('pl', 'przekluwanie-uszu-dzieci-warszawa');

const seoData = {
  title: seoConfig.title,
  description: seoConfig.description,
  language: 'pl',
  canonical: 'https://gentlepiercing.pl/pl/uslugi/przekluwanie-uszu-dzieci-warszawa',
