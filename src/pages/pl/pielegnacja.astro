---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBreadcrumbSchema, getLocalizedPageUrl, getPageSEO, type Locale } from '../../lib/seo';
import { t } from '../../lib/translations';
import Aftercare from '../../components/Aftercare.astro';

const locale: Locale = 'pl';
const baseSeo = getPageSEO(locale, 'aftercare');
const seo = {
  ...baseSeo,
  canonical: getLocalizedPageUrl('aftercare', locale),
  hreflang: {
    pl: getLocalizedPageUrl('aftercare', 'pl'),
    uk: getLocalizedPageUrl('aftercare', 'uk'),
    ru: getLocalizedPageUrl('aftercare', 'ru'),
    en: getLocalizedPageUrl('aftercare', 'en'),
  },
  ogImage: 'https://gentlepiercing.pl/hero/hero-3.jpg',
};

const structuredData = [
  getBreadcrumbSchema([
    { name: t(locale, 'breadcrumb.home'), url: `https://gentlepiercing.pl/${locale}` },
    { name: seo.title.split('|')[0].trim(), url: seo.canonical },
  ]),
];
---

<BaseLayout locale={locale} seo={seo} structuredData={structuredData}>
  <div class="min-h-screen bg-background">
    <Aftercare locale={locale} />
  </div>
</BaseLayout>

