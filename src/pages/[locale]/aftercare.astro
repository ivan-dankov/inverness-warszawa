---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPageSEO, getBreadcrumbSchema, getCanonicalUrl, type Locale } from '../../lib/seo';
import { t } from '../../lib/translations';
import Aftercare from '../../components/Aftercare.astro';

export async function getStaticPaths() {
  const locales: Locale[] = ['pl', 'uk', 'ru', 'en'];
  return locales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params;
const currentLocale = locale as Locale;
const seo = getPageSEO(currentLocale, 'aftercare');

const structuredData = [
  getBreadcrumbSchema([
    { name: t(currentLocale, 'breadcrumb.home'), url: getCanonicalUrl(currentLocale, '') },
    { name: seo.title.split('|')[0].trim(), url: getCanonicalUrl(currentLocale, '/aftercare') },
  ]),
];
---

<BaseLayout locale={currentLocale} seo={seo} structuredData={structuredData}>
  <div class="min-h-screen bg-background">
    <Aftercare locale={currentLocale} />
  </div>
</BaseLayout>

