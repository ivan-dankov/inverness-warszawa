---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteMetadata, generateLocalBusinessSchema, generateAlternates } from '../../config/seo';
import { getBreadcrumbSchema, type Locale } from '../../lib/seo';
import { getTranslations, t } from '../../lib/translations';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import Services from '../../components/Services.astro';
import Gallery from '../../components/Gallery.astro';
import Testimonials from '../../components/Testimonials.astro';
import Comparison from '../../components/Comparison.astro';
import FAQ from '../../components/FAQ.astro';
import RecentArticles from '../../components/RecentArticles.astro';
import ContactHome from '../../components/ContactHome.astro';
import CTASection from '../../components/CTASection.astro';

export async function getStaticPaths() {
  const locales: Locale[] = ['pl', 'uk', 'ru', 'en'];
  return locales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params;
const currentLocale = locale as Locale;

const seo = {
  title: siteMetadata.homepage[currentLocale].title,
  description: siteMetadata.homepage[currentLocale].description,
  canonical: siteMetadata.urls.base + `/${currentLocale}`,
  language: currentLocale,
  alternates: generateAlternates('home'),
  ogImage: siteMetadata.defaultOgImage,
  ogType: 'website',
};

// Build structured data
const structuredData = [
  generateLocalBusinessSchema(currentLocale),
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Gentle Piercing",
    "url": "https://gentlepiercing.pl",
    "logo": "https://gentlepiercing.pl/logo.png",
    "sameAs": [
      "https://www.instagram.com/prokol_ushej_warszawa/",
      "https://www.facebook.com/gentlepiercingwarszawa"
    ]
  },
  getBreadcrumbSchema([
    { name: t(currentLocale, 'breadcrumb.home'), url: seo.canonical },
  ])
];
---

<BaseLayout locale={currentLocale} seo={seo} structuredData={structuredData}>
  <Hero locale={currentLocale} />
  <div class="border-t border-border"></div>
  <About locale={currentLocale} />
  <Services locale={currentLocale} />
  <Gallery locale={currentLocale} />
  <Testimonials locale={currentLocale} />
  <Comparison locale={currentLocale} />
  <FAQ locale={currentLocale} />
  <RecentArticles locale={currentLocale} />
  <CTASection locale={currentLocale} />
  <ContactHome locale={currentLocale} />
</BaseLayout>

