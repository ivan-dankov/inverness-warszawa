---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPageSEO, getLocalBusinessSchema, getOrganizationSchema, getFAQSchema, getBreadcrumbSchema, getCanonicalUrl, type Locale } from '../../lib/seo';
import { getTranslations, t } from '../../lib/translations';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import Services from '../../components/Services.astro';
import Gallery from '../../components/Gallery.astro';
import Testimonials from '../../components/Testimonials.astro';
import Comparison from '../../components/Comparison.astro';
import FAQ from '../../components/FAQ.astro';
import RecentArticles from '../../components/RecentArticles.astro';
import ContactHome from '../../components/ContactHome.astro';
import CTASection from '../../components/CTASection.astro';

export async function getStaticPaths() {
  const locales: Locale[] = ['pl', 'uk', 'ru', 'en'];
  return locales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params;
const currentLocale = locale as Locale;
const baseSeo = getPageSEO(currentLocale, 'home');
const seo = {
  ...baseSeo,
  ogImage: 'https://gentlepiercing.pl/hero/hero-3.jpg',
};

// Get FAQ data for schema
const translations = getTranslations(currentLocale);
const faqs = translations.faq?.items || [];

// Build structured data
const structuredData = [
  getLocalBusinessSchema(currentLocale),
  getOrganizationSchema(),
  getFAQSchema(currentLocale, faqs),
  getBreadcrumbSchema([
    { name: t(currentLocale, 'breadcrumb.home'), url: getCanonicalUrl(currentLocale, '') },
  ]),
];
---

<BaseLayout locale={currentLocale} seo={seo} structuredData={structuredData}>
  <Hero locale={currentLocale} />
  <div class="border-t border-border"></div>
  <About locale={currentLocale} />
  <Services locale={currentLocale} />
  <Gallery locale={currentLocale} />
  <Testimonials locale={currentLocale} />
  <Comparison locale={currentLocale} />
  <FAQ locale={currentLocale} />
  <RecentArticles locale={currentLocale} />
  <CTASection locale={currentLocale} />
  <ContactHome locale={currentLocale} />
</BaseLayout>

