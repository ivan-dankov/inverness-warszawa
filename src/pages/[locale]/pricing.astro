---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPageSEO, type Locale } from '../../lib/seo';

export async function getStaticPaths() {
  const locales: Locale[] = ['pl', 'uk', 'ru', 'en'];
  return locales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params;
const currentLocale = locale as Locale;
const seo = getPageSEO(currentLocale, 'pricing');
---

<BaseLayout locale={currentLocale} seo={seo}>
  <div class="min-h-screen bg-background">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <h1 class="text-4xl font-bold mb-8">Pricing - {locale}</h1>
      <p>Pricing page content will be migrated here.</p>
    </div>
  </div>
</BaseLayout>

