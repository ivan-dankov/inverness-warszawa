---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { siteMetadata } from '../../../config/seo';
import { getPageSEO, getBreadcrumbSchema, getCanonicalUrl, type Locale } from '../../../lib/seo';
import { getPostsByLocale } from '../../../lib/sanity';
import { t } from '../../../lib/translations';
import Articles from '../../../components/Articles.astro';

export async function getStaticPaths() {
  const locales: Locale[] = ['pl', 'uk', 'ru', 'en'];
  return locales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params;
const currentLocale = locale as Locale;
const baseSeo = getPageSEO(currentLocale, 'blog');
const seo = {
  ...baseSeo,
  canonical: getCanonicalUrl(currentLocale, '/blog'),
  hreflang: {
    pl: getCanonicalUrl('pl', '/blog'),
    uk: getCanonicalUrl('uk', '/blog'),
    ru: getCanonicalUrl('ru', '/blog'),
    en: getCanonicalUrl('en', '/blog'),
  },
  ogImage: siteMetadata.defaultOgImage,
};
let posts = [];
try {
  posts = await getPostsByLocale(currentLocale);
  if (posts.length === 0) {
    console.warn(`No posts found for locale: ${currentLocale}`);
  }
} catch (error) {
  console.error('Could not fetch blog posts:', error);
  // Continue with empty posts array
}

const structuredData = [
  getBreadcrumbSchema([
    { name: t(currentLocale, 'breadcrumb.home'), url: getCanonicalUrl(currentLocale, '') },
    { name: t(currentLocale, 'breadcrumb.blog'), url: getCanonicalUrl(currentLocale, '/blog') },
  ]),
];
---

<BaseLayout locale={currentLocale} seo={seo} structuredData={structuredData}>
  <div class="bg-background">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <!-- Breadcrumb -->
      <nav class="mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center flex-wrap gap-x-2 gap-y-1 text-sm text-muted-foreground">
          <li>
            <a href={`/${locale}`} class="hover:text-primary transition-colors">
              {t(currentLocale, 'breadcrumb.home')}
            </a>
          </li>
          <li class="flex items-center">
            <span class="mx-2">/</span>
            <span class="text-foreground font-medium">{t(currentLocale, 'breadcrumb.blog')}</span>
          </li>
        </ol>
      </nav>

      <div class="text-center mb-12">
        <h1 class="text-4xl sm:text-5xl font-bold mb-4">{t(currentLocale, 'blog.title')}</h1>
        <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
          {t(currentLocale, 'blog.subtitle')}
        </p>
      </div>
      
      {posts.length === 0 ? (
        <div class="text-center py-12">
          <p class="text-muted-foreground mb-4">{t(currentLocale, 'blog.noPosts')}</p>
        </div>
      ) : (
        <Articles
          locale={currentLocale}
          posts={posts}
          title={null}
          subtitle={null}
          viewAll={false}
          banded={false}
        />
      )}
    </div>
  </div>
</BaseLayout>

