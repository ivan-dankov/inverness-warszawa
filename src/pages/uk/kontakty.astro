---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { 
  getBreadcrumbSchema, 
  getCanonicalUrl,
  getLocalBusinessSchema,
  getLocalizedPageUrl,
  type Locale 
} from '../../lib/seo';
import { t } from '../../lib/translations';
import Contact from '../../components/Contact.astro';

const locale: Locale = 'uk';

const seo = {
  title: 'Контакти | Gentle Piercing Варшава',
  description: 'Зв\'яжіться з Gentle Piercing у Варшаві. Адреса: Gizów 6, телефон: +48573818260. Забронюйте візит онлайн або поставте запитання.',
  canonical: getLocalizedPageUrl('contact', locale),
  hreflang: {
    pl: getLocalizedPageUrl('contact', 'pl'),
    uk: getLocalizedPageUrl('contact', 'uk'),
    ru: getLocalizedPageUrl('contact', 'ru'),
    en: getLocalizedPageUrl('contact', 'en'),
  },
  ogImage: 'https://gentlepiercing.pl/hero/hero-studio.jpg',
};

const structuredData = [
  await getLocalBusinessSchema(locale),
  getBreadcrumbSchema([
    { name: t(locale, 'breadcrumb.home'), url: getCanonicalUrl(locale, '') },
    { name: t(locale, 'header.nav.contact'), url: seo.canonical },
  ]),
];
---

<BaseLayout locale={locale} seo={seo} structuredData={structuredData}>
  <div class="min-h-screen bg-background">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 max-w-6xl">
      <!-- Breadcrumb -->
      <nav class="mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center flex-wrap gap-x-2 gap-y-1 text-sm text-muted-foreground">
          <li>
            <a href={`/${locale}`} class="hover:text-primary transition-colors">
              {t(locale, 'breadcrumb.home')}
            </a>
          </li>
          <li class="flex items-center">
            <span class="mx-2">/</span>
            <span class="text-foreground font-medium">{t(locale, 'header.nav.contact')}</span>
          </li>
        </ol>
      </nav>

      <!-- Contact Section -->
      <Contact locale={locale} />
    </div>
  </div>
</BaseLayout>

