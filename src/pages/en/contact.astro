---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteMetadata, generateLocalBusinessSchema, generateAlternates } from '../../config/seo';
import { getBreadcrumbSchema } from '../../lib/seo';
import { t } from '../../lib/translations';
import Contact from '../../components/Contact.astro';

const locale = 'en';
const seo = {
  title: "Book Online | Gentle Piercing | ☎️ +48 573-818-260 | Mokotów Warsaw",
  description: "📍 Ursynowska 10/1, Mokotów, Warsaw ☎️ +48 573-818-260 🕐 Mon-Sun 10am-8pm 🚇 Metro Wilanowska 12min walk | Book Inverness Med ear piercing online via Booksy ✓",
  language: 'en',
  canonical: siteMetadata.urls.contact.en,
  hreflang: generateAlternates('contact'),
  ogImage: 'https://gentlepiercing.pl/hero/hero-studio.jpg',
};

const structuredData = [
  generateLocalBusinessSchema(locale),
  getBreadcrumbSchema([
    { name: 'Home', url: siteMetadata.urls.base + '/en' },
    { name: 'Contact', url: seo.canonical },
  ]),
];
---

<BaseLayout locale={locale} seo={seo} structuredData={structuredData}>
  <div class="min-h-screen bg-background">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 max-w-6xl">
      <!-- Breadcrumb -->
      <nav class="mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center flex-wrap gap-x-2 gap-y-1 text-sm text-muted-foreground">
          <li>
            <a href={`/${locale}`} class="hover:text-primary transition-colors">
              {t(locale, 'breadcrumb.home')}
            </a>
          </li>
          <li class="flex items-center">
            <span class="mx-2">/</span>
            <span class="text-foreground font-medium">{t(locale, 'header.nav.contact')}</span>
          </li>
        </ol>
      </nav>

      <!-- Contact Section -->
      <Contact locale={locale} />
    </div>
  </div>
</BaseLayout>

