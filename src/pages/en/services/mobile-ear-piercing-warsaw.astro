---
import ServicePageWrapper from "../../../components/ServicePageWrapper.astro";import { siteMetadata, generateAlternates } from '../../../config/seo';

const seoData = {
  title: "Mobile Ear Piercing Warsaw | Home Visit | +90 PLN",
  description: "✓ Ear piercing at your home ✓ All Warsaw districts ✓ Children and adults ✓ Inverness Med System ✓ +90 PLN travel fee ✓ Book appointment",
  language: 'en',
  canonical: 'https://gentlepiercing.pl/en/services/mobile-ear-piercing-warsaw',
  hreflang: generateAlternates('services.mobile'),
  ogImage: 'https://gentlepiercing.pl/hero/hero-kids.jpg',
};

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Mobile Ear Piercing",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Gentle Piercing",
      "image": "https://gentlepiercing.pl/preview.png",
      "telephone": "+48573818260"
    },
    "offers": {
      "@type": "Offer",
      "price": "360",
      "priceCurrency": "PLN",
      "description": "Base price + 90 PLN travel fee"
    }
  }
];
---

<ServicePageWrapper 
  locale="en"
  serviceSlug="przekluwanie-uszu-z-dojazdem-warszawa"
