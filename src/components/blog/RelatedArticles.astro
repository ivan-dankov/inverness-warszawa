---
import { urlFor } from '../../lib/sanity';
import { t } from '../../lib/translations';
import type { Locale } from '../../lib/seo';
import type { Post } from '../../lib/sanity';

interface Props {
  locale: Locale;
  relatedArticles?: Post[];
}

const { locale, relatedArticles } = Astro.props;

// Only show articles in the same locale and exclude the current article
const filteredArticles = relatedArticles?.filter(
  (article) => article.locale === locale
) || [];
---

{filteredArticles.length > 0 && (
  <section class="mt-16 pt-8 border-t border-border">
    <h2 class="text-3xl font-semibold text-foreground mb-6">
      {t(locale, 'blog.relatedArticles.title')}
    </h2>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {filteredArticles.map((article) => (
        <article class="border border-border rounded-lg overflow-hidden hover:shadow-card transition-shadow duration-300 flex flex-col group">
          <a href={`/${locale}/blog/${article.slug}`} class="block flex flex-col h-full no-underline text-inherit hover:text-inherit">
            {article.coverImage && (
              <img
                src={urlFor(article.coverImage).width(400).url()}
                alt={article.title}
                class="w-full h-48 object-cover"
              />
            )}
            <div class="p-4 flex flex-col flex-grow">
              <h3 class="text-xl font-semibold mb-2 group-hover:text-primary transition-colors">
                {article.title}
              </h3>
              <p class="text-muted-foreground text-sm mb-4 flex-grow line-clamp-3">
                {article.excerpt}
              </p>
              <div class="flex items-center justify-between text-xs text-muted-foreground">
                {article.publishedAt && (
                  <time>
                    {new Date(article.publishedAt).toLocaleDateString(
                      locale === 'pl' ? 'pl-PL' :
                      locale === 'uk' ? 'uk-UA' :
                      locale === 'ru' ? 'ru-RU' : 'en-US',
                      { year: 'numeric', month: 'short', day: 'numeric' }
                    )}
                  </time>
                )}
                <span class="text-primary group-hover:underline">
                  {t(locale, 'blog.relatedArticles.readMore')} →
                </span>
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
)}

