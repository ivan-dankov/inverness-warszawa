---
import { t } from '../../lib/translations';
import type { Locale } from '../../lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

function getBooksyUrl(locale: Locale): string {
  const baseUrl = 'https://booksy.com/pl-pl/dl/show-business/319418';
  const utmParams = new URLSearchParams({
    utm_source: 'blog',
    utm_medium: 'cta',
    utm_campaign: `ear_piercing_${locale}`,
  });
  return `${baseUrl}?${utmParams.toString()}`;
}

const booksyUrl = getBooksyUrl(locale);

const getHeading = () => {
  if (locale === 'uk') return 'Резервація';
  if (locale === 'ru') return 'Резервация';
  if (locale === 'en') return 'Booking';
  return 'Rezerwacja';
};

const getBookNowText = () => {
  if (locale === 'uk') return 'Запишіться на візит вже сьогодні:';
  if (locale === 'ru') return 'Запишитесь на визит уже сегодня:';
  if (locale === 'en') return 'Book an appointment today:';
  return 'Umów wizytę już dziś:';
};

const getPhoneLabel = () => {
  if (locale === 'uk') return 'Телефон';
  if (locale === 'ru') return 'Телефон';
  if (locale === 'en') return 'Phone';
  return 'Telefon';
};
---

<section class="mt-16 pt-8 border-t border-border">
  <h2 class="text-3xl font-semibold text-foreground mb-4">
    {getHeading()}
  </h2>
  <p class="text-foreground mb-4">{getBookNowText()}</p>
  <p class="text-foreground mb-4">
    <strong>Booksy</strong> →{' '}
    <a
      href={booksyUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="text-primary hover:underline"
      id="blog-cta-booking-link"
    >
      {locale === 'pl' ? 'Rezerwuj Online' : locale === 'uk' ? 'Забронюйте онлайн' : locale === 'ru' ? 'Забронируйте онлайн' : 'Book Online'}
    </a>
    <br />
    <strong>{getPhoneLabel()}</strong> →{' '}
    <a
      href="tel:+48573818260"
      class="text-primary hover:underline"
    >
      +48 573 818 260
    </a>
  </p>
</section>

<script define:vars={{ locale }}>
  // Google Analytics - Track booking link click
  const blogCtaLink = document.getElementById('blog-cta-booking-link');
  if (blogCtaLink && window.gtag) {
    blogCtaLink.addEventListener('click', () => {
      gtag('event', 'booking_click_code', {
        button_location: 'blog_cta',
        locale: locale,
        booking_platform: 'booksy'
      });
    });
  }
</script>

