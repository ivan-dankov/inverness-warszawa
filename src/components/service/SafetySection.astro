---
interface Props {
  title: string;
  content: string[];
}

const { title, content } = Astro.props;
---

<section class="mb-16 py-12">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
    <h2 class="text-3xl font-bold mb-8 text-foreground text-center">
      {title}
    </h2>
    
    <div class="space-y-6 text-muted-foreground leading-relaxed">
      {content.map((paragraph, index) => (
        <p key={index} class="text-base sm:text-lg">
          {paragraph}
        </p>
      ))}
    </div>

    <!-- Visual Separator -->
    <div class="mt-12 flex items-center justify-center">
      <div class="flex-1 h-px bg-gradient-to-r from-transparent via-border to-transparent"></div>
      <div class="mx-4 h-16 w-16 rounded-full bg-primary/10 flex items-center justify-center">
        <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
      </div>
      <div class="flex-1 h-px bg-gradient-to-r from-transparent via-border to-transparent"></div>
    </div>
  </div>
</section>

