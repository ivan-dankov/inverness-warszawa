---
import type { Locale } from '../../lib/seo';
import { getLocalizedPagePath } from '../../lib/seo';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  checklist: string[];
  link: { text: string; page: string };
}

const { locale, title, description, checklist, link } = Astro.props;
const aftercareUrl = getLocalizedPagePath('aftercare', locale);
---

<section class="mb-16">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
    <h2 class="text-3xl font-bold mb-6 text-foreground text-center">
      {title}
    </h2>
    
    <p class="text-base sm:text-lg text-muted-foreground leading-relaxed mb-8 text-center">
      {description}
    </p>

    <!-- Checklist -->
    <div class="bg-card border border-border rounded-xl p-8 mb-8">
      <ul class="space-y-4">
        {checklist.map((item, index) => (
          <li key={index} class="flex items-start gap-4">
            <div class="mt-1 h-6 w-6 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 text-primary">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <span class="text-base text-muted-foreground font-medium pt-0.5">
              {item}
            </span>
          </li>
        ))}
      </ul>
    </div>

    <div class="text-center">
      <a 
        href={aftercareUrl}
        class="inline-flex items-center gap-2 text-primary font-semibold hover:underline group"
      >
        {link.text}
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</section>

