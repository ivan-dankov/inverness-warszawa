---
interface Props {
  title: string;
  content: string[];
  standards: Array<{ icon: string; text: string }>;
}

const { title, content, standards } = Astro.props;

const iconMap: Record<string, string> = {
  experience: '⭐',
  hygiene: '🧼',
  certified: '✅',
};
---

<section class="mb-16">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
    <h2 class="text-3xl font-bold mb-8 text-foreground text-center">
      {title}
    </h2>
    
    <div class="space-y-6 text-muted-foreground leading-relaxed mb-12">
      {content.map((paragraph, index) => (
        <p key={index} class="text-base sm:text-lg">
          {paragraph}
        </p>
      ))}
    </div>

    <!-- Standards Icons -->
    <div class="grid sm:grid-cols-3 gap-6">
      {standards.map((standard, index) => (
        <div 
          key={index}
          class="bg-card border border-border rounded-xl p-6 text-center hover:shadow-lg transition-shadow duration-300"
        >
          <div class="text-4xl mb-4">
            {iconMap[standard.icon] || '✓'}
          </div>
          <p class="text-base font-medium text-foreground">
            {standard.text}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

