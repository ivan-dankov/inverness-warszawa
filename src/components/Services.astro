---
import { t, getTranslations } from '../lib/translations';
import type { Locale } from '../lib/seo';
import { getServicePagePath, getLocalizedPagePath, type ServicePageSlug } from '../lib/seo';
import { Image } from 'astro:assets';
import childrenImg from '../assets/services/children.webp';
import adultsImg from '../assets/ear-1.jpg';
import cartilageImg from '../assets/ear-2.jpg';
import mobileImg from '../assets/services/mobile.webp';

interface Props {
  locale: Locale;
  useH1?: boolean;
  hideViewAllButton?: boolean;
}

const { locale, useH1 = false, hideViewAllButton = false } = Astro.props;
const translations = getTranslations(locale);
const servicesCards = translations.services?.cards || [];
const pricing = translations.services?.pricing || {};

// Service page slugs and their data - only children, adults, and cartilage
const servicePages: Array<{ slug: ServicePageSlug; nameKey: string; desc: Record<Locale, string> }> = [
  { 
    slug: 'przekluwanie-uszu-dzieci-warszawa', 
    nameKey: 'children',
    desc: {
      pl: 'Bezpieczne i delikatne przekłuwanie uszu dla dzieci od 0+, zatwierdzone przez lekarzy.',
      en: 'Safe and gentle ear piercing for children from 0+, doctor-approved.',
      uk: 'Безпечний та делікатний прокол вух для дітей від 0+, схвалений лікарями.',
      ru: 'Безопасный и деликатный прокол ушей для детей от 0+, одобренный врачами.',
    }
  },
  { 
    slug: 'przekluwanie-uszu-dorosli-warszawa', 
    nameKey: 'adults',
    desc: {
      pl: 'Przekłuwanie uszu dla dorosłych - płatek ucha i chrząstka w profesjonalnych warunkach.',
      en: 'Ear piercing for adults - earlobe and cartilage in professional conditions.',
      uk: 'Прокол вух для дорослих - мочка вуха та хрящ у професійних умовах.',
      ru: 'Прокол ушей для взрослых - мочка уха и хрящ в профессиональных условиях.',
    }
  },
  { 
    slug: 'przekluwanie-chrzastki-warszawa', 
    nameKey: 'cartilage',
    desc: {
      pl: 'Specjalizujemy się w przekłuwaniu chrząstki: helix, tragus, conch systemem Inverness MED.',
      en: 'We specialize in cartilage piercing: helix, tragus, conch with Inverness MED system.',
      uk: 'Спеціалізуємося на проколі хряща: helix, tragus, conch системою Inverness MED.',
      ru: 'Специализируемся на проколе хряща: helix, tragus, conch системой Inverness MED.',
    }
  },
];

const serviceNames: Record<string, Record<Locale, string>> = {
  children: {
    pl: 'Przekłuwanie uszu dzieciom',
    en: 'Ear piercing for children',
    uk: 'Прокол вух дітям',
    ru: 'Прокол ушей детям',
  },
  adults: {
    pl: 'Przekłuwanie uszu dla dorosłych',
    en: 'Earlobe piercing for adults',
    uk: 'Прокол мочки вуха для дорослих',
    ru: 'Прокол мочки уха для взрослых',
  },
  cartilage: {
    pl: 'Przekłuwanie chrząstki',
    en: 'Cartilage piercing',
    uk: 'Прокол хряща',
    ru: 'Прокол хряща',
  },
  mobile: {
    pl: 'Przekłuwanie uszu z dojazdem',
    en: 'Mobile ear piercing',
    uk: 'Прокол вух з виїздом',
    ru: 'Прокол ушей с выездом',
  },
};

// Map service slugs to their prices from translations
// Based on Services.astro mapping: index 0 = cartilage, 1 = children, 2 = mobile
const servicePriceMap: Record<ServicePageSlug, string> = {
  'przekluwanie-chrzastki-warszawa': servicesCards[0]?.price || '',
  'przekluwanie-uszu-dzieci-warszawa': servicesCards[1]?.price || '',
  'przekluwanie-uszu-z-dojazdem-warszawa': servicesCards[2]?.price || '',
  'przekluwanie-uszu-dorosli-warszawa': servicesCards[0]?.price || '', // Adults use same pricing as cartilage
  'przekluwanie-uszu-warszawa': servicesCards[0]?.price || '', // Legacy
};
---

<section id="services" class="py-24 sm:py-32 bg-background border-t border-border">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      {useH1 ? (
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground mb-4">
          {t(locale, 'services.title')}
        </h1>
      ) : (
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground mb-4">
          {t(locale, 'services.title')}
        </h2>
      )}
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
        {t(locale, 'services.subtitle')}
      </p>
    </div>

    {/* All 4 services as uniform horizontal cards */}
    {(() => {
      const allServices = [
        ...servicePages.map(s => ({
          slug: s.slug,
          nameKey: s.nameKey,
          desc: s.desc[locale],
          img: s.nameKey === 'children' ? childrenImg : s.nameKey === 'adults' ? adultsImg : cartilageImg,
        })),
        {
          slug: 'przekluwanie-uszu-z-dojazdem-warszawa' as ServicePageSlug,
          nameKey: 'mobile',
          desc: locale === 'pl' ? 'Usługa mobilna z dojazdem do domu — przekłuwanie uszu w komforcie Twojego domu.'
              : locale === 'en' ? 'Mobile service with home visits — ear piercing in the comfort of your home.'
              : locale === 'uk' ? 'Мобільна послуга з виїздом додому — прокол вух у комфорті вашого дому.'
              : 'Мобильная услуга с выездом на дом — прокол ушей в комфорте вашего дома.',
          img: mobileImg,
        },
      ];

      return (
        <div class="max-w-6xl mx-auto space-y-5 mb-10">
          {allServices.map((s) => {
            const url = getServicePagePath(s.slug, locale);
            const name = serviceNames[s.nameKey]?.[locale] || '';
            const price = servicePriceMap[s.slug];
            const booksyUrl = `https://booksy.com/pl-pl/dl/show-business/319418?utm_source=homepage&utm_medium=cta&utm_campaign=${s.slug}_${locale}`;
            return (
              <div class="group flex flex-row bg-card border border-border rounded-2xl overflow-hidden hover:shadow-lg transition-all duration-300">
                {/* Illustration */}
                <a href={url} class="block w-32 sm:w-44 flex-shrink-0 bg-white dark:bg-zinc-100">
                  <Image
                    src={s.img}
                    alt={name}
                    class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-105"
                    widths={[176, 352]}
                    sizes="176px"
                  />
                </a>
                {/* Content */}
                <div class="flex flex-col sm:flex-row flex-1 items-start sm:items-center gap-4 sm:gap-8 p-5 sm:p-7">
                  <div class="flex-1 min-w-0">
                    <a href={url}>
                      <h3 class="text-lg font-bold text-foreground mb-2 group-hover:text-primary transition-colors leading-snug">{name}</h3>
                      <p class="text-base text-muted-foreground leading-relaxed line-clamp-2">{s.desc}</p>
                    </a>
                  </div>
                  <div class="flex flex-col items-start sm:items-end gap-3 flex-shrink-0 w-full sm:w-auto">
                    <span class="text-xl font-bold text-primary whitespace-nowrap">{price}</span>
                    <a
                      href={booksyUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center justify-center gap-2 rounded-lg text-sm font-semibold bg-primary text-primary-foreground hover:bg-primary/90 transition-all h-10 px-5 whitespace-nowrap"
                      data-booking-button="services"
                      onclick="event.stopPropagation();"
                    >
                      <svg class="h-4 w-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                      {t(locale, 'services.bookButton')}
                    </a>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      );
    })()}

    {/* Pricing footnote */}
    <div class="max-w-6xl mx-auto mb-10 flex items-start gap-2 px-1">
      <svg class="h-4 w-4 text-muted-foreground flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <p class="text-sm text-muted-foreground leading-relaxed">
        {pricing.earringsInfo} — {pricing.earringsPrice}
      </p>
    </div>

    {!hideViewAllButton && (
      <div class="text-center mb-8">
        <a
          href={getLocalizedPagePath('services', locale)}
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-semibold border border-border bg-background hover:bg-accent hover:text-accent-foreground transition-colors h-12 px-8 text-base group"
        >
          {locale === 'pl' ? 'Zobacz wszystkie usługi' :
           locale === 'en' ? 'View all services' :
           locale === 'uk' ? 'Переглянути всі послуги' :
           'Посмотреть все услуги'}
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    )}
  </div>
</section>

<script define:vars={{ locale }}>
  // Google Analytics - Track booking button clicks in services
  document.querySelectorAll('[data-booking-button="services"]').forEach(button => {
    if (button && window.gtag) {
      button.addEventListener('click', () => {
        gtag('event', 'booking_click_code', {
          button_location: 'services',
          locale: locale,
          booking_platform: 'booksy'
        });
      });
    }
  });
</script>
