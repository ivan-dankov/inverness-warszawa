---
import { t, getTranslations } from '../lib/translations';
import type { Locale } from '../lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translations = getTranslations(locale);
const servicesData = translations.services?.cards || [];
const pricing = translations.services?.pricing || {};
---

<section id="services" class="py-20 bg-background border-t border-border">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground mb-4">
        {t(locale, 'services.title')}
      </h2>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
        {t(locale, 'services.subtitle')}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto mb-12">
      {servicesData.map((service: any, index: number) => {
        const booksyUrl = `https://booksy.com/pl-pl/dl/show-business/319418?utm_source=homepage&utm_medium=cta&utm_campaign=${locale}_services`;
        return (
          <div key={index} class="p-6 sm:p-8 bg-card rounded-lg border border-border hover:shadow-card transition-shadow duration-300 flex flex-col">
            <div class="h-12 w-12 text-primary mb-4">
              {index === 0 && (
                <svg class="h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                </svg>
              )}
              {index === 1 && (
                <svg class="h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
              )}
              {index === 2 && (
                <svg class="h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              )}
            </div>
            <h3 class="text-2xl font-bold text-foreground mb-2">
              {service.title}
            </h3>
            <p class="text-muted-foreground mb-4 text-sm">
              {service.description}
            </p>
            
            <div class="flex flex-col gap-1 mb-4">
              <div class="flex items-baseline gap-2">
                <span class="text-4xl font-bold text-primary">{service.price}</span>
              </div>
            </div>
            
            <div class="text-sm text-muted-foreground mb-6">
              {t(locale, 'services.durationLabel')} {service.duration}
            </div>

            <ul class="space-y-2 mb-6 flex-grow">
              {service.features?.map((feature: string, idx: number) => (
                <li key={idx} class="flex items-start gap-2 text-sm text-muted-foreground">
                  <span class="text-primary mt-0.5">✓</span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>

            <a 
              href={booksyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-semibold bg-gradient-to-r from-primary to-primary/90 text-primary-foreground hover:shadow-card transition-shadow duration-300 h-12 px-4 w-full mt-auto"
              data-booking-button="services"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              {t(locale, 'services.bookButton')}
            </a>
          </div>
        );
      })}
    </div>

    <div class="mt-12 max-w-6xl mx-auto">
      <div class="grid sm:grid-cols-1 md:grid-cols-3 gap-4">
        <div class="flex items-start gap-3 p-6 bg-muted/50 rounded-lg border border-border hover:bg-muted/70 hover:border-primary/30 transition-all shadow-sm">
          <svg class="h-5 w-5 text-primary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p class="text-sm text-foreground leading-relaxed">
            {pricing.earringsInfo}
          </p>
        </div>

        <div class="flex items-start gap-3 p-6 bg-muted/50 rounded-lg border border-border hover:bg-muted/70 hover:border-primary/30 transition-all shadow-sm">
          <svg class="h-5 w-5 text-primary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
          </svg>
          <p class="text-sm text-foreground leading-relaxed">
            {pricing.earringsPrice}
          </p>
        </div>

        <div class="flex items-start gap-3 p-6 bg-muted/50 rounded-lg border border-border hover:bg-muted/70 hover:border-primary/30 transition-all shadow-sm">
          <svg class="h-5 w-5 text-primary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
          </svg>
          <p class="text-sm text-foreground leading-relaxed">
            {pricing.mobileVisit}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ locale }}>
  // Google Analytics - Track booking button clicks in services
  document.querySelectorAll('[data-booking-button="services"]').forEach(button => {
    if (button && window.gtag) {
      button.addEventListener('click', () => {
        gtag('event', 'booking_click_code', {
          button_location: 'services',
          locale: locale,
          booking_platform: 'booksy'
        });
      });
    }
  });
</script>

