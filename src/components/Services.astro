---
import { Image } from 'astro:assets';
import { t, getTranslations } from '../lib/translations';
import { getLocalizedPagePath, type Locale, type ServicePageSlug } from '../lib/seo';
import { getServiceItems, type ServiceId } from '../lib/services';
import { getBooksyUrl } from '../lib/booksy';
import childrenImg from '../assets/services/children.webp';
import adultsImg from '../assets/ear-1.jpg';
import cartilageImg from '../assets/ear-2.jpg';
import mobileImg from '../assets/services/mobile.webp';
import earringOneImg from '../assets/services/earring-one.webp';
import earringPairImg from '../assets/services/earring-pair.webp';

interface Props {
  locale: Locale;
  headingLevel?: 1 | 2;
  title?: string;
  subtitle?: string | null;
  exclude?: ServicePageSlug[];
  include?: ServiceId[];
  showViewAll?: boolean;
  showPricingNote?: boolean;
  featuredFirst?: boolean;
  spaced?: boolean;
  contained?: boolean;
  headingId?: string;
  id?: string;
  class?: string;
}

const {
  locale,
  headingLevel = 2,
  title = t(locale, 'services.title'),
  subtitle = t(locale, 'services.subtitle'),
  exclude,
  include,
  showViewAll = false,
  showPricingNote = true,
  featuredFirst = true,
  spaced = true,
  contained = true,
  headingId = 'services-heading',
  id = 'services',
  class: className = '',
} = Astro.props;

const pricing = getTranslations(locale).services?.pricing || {};
const items = getServiceItems(locale, { exclude, include });
const images = {
  children: childrenImg,
  adults: adultsImg,
  cartilage: cartilageImg,
  mobile: mobileImg,
} as const;

const HeadingTag = headingLevel === 1 ? 'h1' : 'h2';
---

{items.length > 0 && (
  <section
    id={id}
    class:list={[
      'bg-background',
      spaced && 'py-24 sm:py-32 border-t border-border',
      className,
    ]}
    aria-labelledby={headingId}
  >
    <div class:list={[contained && 'container mx-auto px-4 sm:px-6 lg:px-8']}>
      <div class:list={[contained && 'max-w-6xl mx-auto']}>
        <header class="mb-10 sm:mb-14 max-w-2xl">
          <HeadingTag
            id={headingId}
            class:list={[
              'font-bold text-foreground leading-tight tracking-tight',
              headingLevel === 1
                ? 'text-4xl sm:text-5xl lg:text-6xl mb-6'
                : 'text-3xl sm:text-4xl lg:text-5xl mb-4',
            ]}
          >
            {title}
          </HeadingTag>
          {subtitle && (
            <p class="text-lg sm:text-xl text-muted-foreground leading-relaxed">
              {subtitle}
            </p>
          )}
        </header>

        <ul class="divide-y divide-border border-y border-border">
          {items.map((item, index) => {
            const featured = featuredFirst && index === 0;
            const booksyUrl = getBooksyUrl({
              source: 'services',
              campaign: `${item.slug}_${locale}`,
            });
            return (
              <li data-reveal data-reveal-delay={String(index + 1)}>
                <div
                  class:list={[
                    'grid items-center gap-5 sm:gap-8',
                    featured
                      ? 'py-8 sm:py-10 md:grid-cols-[minmax(0,17rem)_1fr]'
                      : 'py-6 sm:py-7 grid-cols-[auto_1fr]',
                  ]}
                >
                  <a
                    href={item.href}
                    class="block rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
                  >
                    <Image
                      src={images[item.id]}
                      alt={item.name}
                      class:list={[
                        'rounded-lg bg-muted/40 object-contain w-full',
                        featured
                          ? 'aspect-[4/3] max-h-56 sm:max-h-none'
                          : 'w-24 h-24 sm:w-28 sm:h-28',
                      ]}
                      widths={featured ? [280, 560] : [112, 224]}
                      sizes={featured ? '(max-width: 768px) 90vw, 272px' : '112px'}
                    />
                  </a>
                  <div class="min-w-0 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 sm:gap-8">
                    <a
                      href={item.href}
                      class="min-w-0 group rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
                    >
                      <h3
                        class:list={[
                          'font-bold text-foreground group-hover:text-primary transition-colors leading-snug',
                          featured ? 'text-xl sm:text-2xl' : 'text-lg',
                        ]}
                      >
                        {item.name}
                      </h3>
                      <p class="text-sm sm:text-base text-muted-foreground leading-relaxed mt-1">
                        {item.description}
                      </p>
                    </a>
                    <div class="flex flex-col items-start sm:items-end gap-2 flex-shrink-0">
                      {item.price && (
                        <span class="text-base sm:text-lg font-bold text-primary whitespace-nowrap">
                          {item.price}
                        </span>
                      )}
                      <a
                        href={booksyUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 text-base sm:text-lg font-bold text-primary hover:underline underline-offset-4 whitespace-nowrap focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 rounded-sm"
                        data-booking-cta="services"
                        data-booking-locale={locale}
                      >
                        {t(locale, 'services.bookButton')}
                        <svg class="w-[1em] h-[1em]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                        </svg>
                      </a>
                    </div>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>

        {showPricingNote && (pricing.earringsInfo || pricing.earringsOneValue) && (
          <aside
            class="relative overflow-hidden rounded-lg bg-[hsl(221,43%,18%)] px-5 py-6 sm:px-8 sm:py-7 mt-6 text-white"
            data-reveal
            data-reveal-delay={String(items.length + 1)}
          >
            <div class="absolute -top-10 right-0 w-48 h-48 bg-primary opacity-40 rounded-full blur-3xl pointer-events-none" aria-hidden="true" />
            <div class="absolute bottom-0 left-1/3 w-40 h-40 bg-secondary opacity-25 rounded-full blur-3xl pointer-events-none" aria-hidden="true" />
            <div class="relative z-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
              <div class="min-w-0 max-w-xl">
                <p class="text-xs uppercase tracking-[0.16em] text-secondary font-semibold mb-2">
                  {pricing.earringsLabel}
                </p>
                <p class="text-lg sm:text-xl font-bold leading-snug">
                  {pricing.earringsInfo}
                </p>
              </div>
              <div class="grid grid-cols-2 gap-3 w-full lg:w-auto lg:min-w-[22rem]">
                <div class="flex items-center gap-3 rounded-lg bg-white/10 ring-1 ring-white/15 px-3 py-3 min-w-0">
                  <Image
                    src={earringOneImg}
                    alt=""
                    class="w-16 h-16 sm:w-[4.5rem] sm:h-[4.5rem] rounded-lg bg-white object-contain flex-shrink-0"
                    widths={[72, 144]}
                    sizes="72px"
                  />
                  <div class="min-w-0">
                    <p class="text-xs text-white/60 mb-0.5">{pricing.earringsOneUnit}</p>
                    <p class="text-xl font-bold tabular-nums">{pricing.earringsOneValue}</p>
                  </div>
                </div>
                <div class="flex items-center gap-3 rounded-lg bg-white/10 ring-1 ring-white/15 px-3 py-3 min-w-0">
                  <Image
                    src={earringPairImg}
                    alt=""
                    class="w-16 h-16 sm:w-[4.5rem] sm:h-[4.5rem] rounded-lg bg-white object-contain flex-shrink-0"
                    widths={[72, 144]}
                    sizes="72px"
                  />
                  <div class="min-w-0">
                    <p class="text-xs text-white/60 mb-0.5">{pricing.earringsPairUnit}</p>
                    <p class="text-xl font-bold tabular-nums">{pricing.earringsPairValue}</p>
                  </div>
                </div>
              </div>
            </div>
          </aside>
        )}

        {showViewAll && (
          <p class="mt-8">
            <a
              href={getLocalizedPagePath('services', locale)}
              class="inline-flex items-center gap-2 text-primary font-semibold hover:underline underline-offset-4"
            >
              {t(locale, 'services.viewAll')}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </p>
        )}
      </div>
    </div>
  </section>
)}

<script>
  const reveals = document.querySelectorAll('[data-reveal]');
  if (reveals.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -40px 0px' },
    );
    reveals.forEach((el) => observer.observe(el));
  }
</script>
