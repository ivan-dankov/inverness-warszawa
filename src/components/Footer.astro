---
import { t } from '../lib/translations';
import type { Locale } from '../lib/seo';
import { PAGE_SLUGS, getServicePagePath, type ServicePageSlug } from '../lib/seo';
import { getLocationPath, getLocationsBasePath, locations } from '../data/locations';
import logoWideDark from '../assets/logo-wide-dark.svg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentYear = new Date().getFullYear();

const serviceLinks: Array<{ slug: ServicePageSlug; labelKey: string }> = [
  { slug: 'przekluwanie-uszu-dzieci-warszawa', labelKey: 'footer.services.children' },
  { slug: 'przekluwanie-uszu-dorosli-warszawa', labelKey: 'footer.services.adults' },
  { slug: 'przekluwanie-chrzastki-warszawa', labelKey: 'footer.services.cartilage' },
  { slug: 'przekluwanie-uszu-z-dojazdem-warszawa', labelKey: 'footer.services.mobile' },
];
---

<footer class="bg-muted/50 border-t border-border">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <div>
        <div class="mb-4">
          <img src={logoWideDark.src || logoWideDark} alt="Gentle Piercing" class="h-8 w-auto" width="320" height="64" loading="lazy" decoding="async" />
        </div>
        <p class="text-sm text-muted-foreground mb-4">
          {t(locale, 'footer.company.description')}
        </p>
        <div class="text-sm text-muted-foreground/70">
          <p class="font-medium text-muted-foreground">Kseniya Askerka</p>
          <p>NIP: 5214067116</p>
          <p>REGON: 528446661</p>
        </div>
      </div>

      <div>
        <h3 class="font-semibold text-foreground mb-4">{t(locale, 'footer.contact.title')}</h3>
        <div class="space-y-2 text-sm text-muted-foreground">
          <p>Ursynowska 10/1, 02-605 Warszawa</p>
          <p>
            <a href="tel:+48573818260" class="hover:text-primary transition-colors">
              +48 573 818 260
            </a>
          </p>
          <p>
            <a href={`mailto:${t(locale, 'contact.emailAddress')}`} class="hover:text-primary transition-colors">
              {t(locale, 'contact.emailAddress')}
            </a>
          </p>
          <div class="flex gap-4 mt-4">
            <a 
              href="tel:+48573818260" 
              class="h-10 w-10 rounded-full bg-primary/10 flex items-center justify-center hover:bg-primary/20 transition-colors"
              aria-label="Telefon"
            >
              <svg class="h-5 w-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </a>
            <a 
              href="https://instagram.com/prokol_ushej_warszawa" 
              target="_blank"
              rel="noopener noreferrer"
              class="h-10 w-10 rounded-full bg-primary/10 flex items-center justify-center hover:bg-primary/20 transition-colors"
              aria-label="Instagram"
            >
              <svg class="h-5 w-5 text-primary" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
            <a 
              href={`mailto:${t(locale, 'contact.emailAddress')}`} 
              class="h-10 w-10 rounded-full bg-primary/10 flex items-center justify-center hover:bg-primary/20 transition-colors"
              aria-label={t(locale, 'contact.email')}
            >
              <svg class="h-5 w-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <div>
        <h3 class="font-semibold text-foreground mb-4">{t(locale, 'footer.services.title')}</h3>
        <ul class="space-y-2 text-sm text-muted-foreground">
          {serviceLinks.map(({ slug, labelKey }) => (
            <li>
              <a href={getServicePagePath(slug, locale)} class="hover:text-primary transition-colors">
                {t(locale, labelKey)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-foreground mb-4">{t(locale, 'footer.links.title')}</h3>
        <ul class="space-y-2 text-sm text-muted-foreground">
          <li>
            <a href={`/${locale}/${PAGE_SLUGS.aftercare[locale]}`} class="hover:text-primary transition-colors">
              {t(locale, 'footer.links.aftercare')}
            </a>
          </li>
          <li>
            <a href={`/${locale}/blog`} class="hover:text-primary transition-colors">
              {t(locale, 'footer.links.blog')}
            </a>
          </li>
          <li>
            <a href={`/${locale}/${PAGE_SLUGS.contact[locale]}`} class="hover:text-primary transition-colors">
              {t(locale, 'footer.links.contact')}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-8 border-t border-border">
      <h3 class="text-xs uppercase tracking-[0.16em] text-muted-foreground font-semibold mb-4">
        {t(locale, 'locations.footerHeading')}
      </h3>
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted-foreground">
        {locations.map((location) => (
          <li>
            <a href={getLocationPath(location.slug, locale)} class="hover:text-primary transition-colors">
              {location.content[locale].name}
            </a>
          </li>
        ))}
        <li>
          <a href={getLocationsBasePath(locale)} class="text-foreground font-medium hover:text-primary transition-colors">
            {t(locale, 'locations.nearby.all')}
          </a>
        </li>
      </ul>
    </div>

    <div class="mt-12 pt-8 border-t border-border flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-muted-foreground">
      <p>{t(locale, 'footer.copyright').replace('{{year}}', currentYear.toString())}</p>
      <div>
        <slot name="language-switch" />
      </div>
    </div>
  </div>
</footer>
