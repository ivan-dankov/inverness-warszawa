---
import { t, getTranslations } from '../lib/translations';
import type { Locale } from '../lib/seo';

interface Props {
  locale: Locale;
  compact?: boolean;
  split?: boolean;
  showTable?: boolean;
  width?: string;
}

const { locale, compact = false, split = false, showTable = true, width = 'max-w-6xl' } = Astro.props;
const translations = getTranslations(locale);
const comparison = translations.comparison || {};

type Method = 'gun' | 'needle' | 'inverness';
type Attribute = 'sterility' | 'comfort' | 'healing' | 'childrenSuitability' | 'cartilageSuitability' | 'features';
type Score = 'good' | 'ok' | 'bad' | 'neutral';

const methods: Method[] = ['gun', 'needle', 'inverness'];
const attributes: Attribute[] = ['sterility', 'comfort', 'healing', 'childrenSuitability', 'cartilageSuitability', 'features'];

// Unified scoring map — drives the colored status dot in every cell.
// Replaces the previous mix of check / x / warning icons with a consistent
// visual language so users can scan the table at a glance.
const scores: Record<Method, Record<Attribute, Score>> = {
  gun: {
    sterility: 'bad',
    comfort: 'bad',
    healing: 'bad',
    childrenSuitability: 'bad',
    cartilageSuitability: 'bad',
    features: 'neutral',
  },
  needle: {
    sterility: 'good',
    comfort: 'ok',
    healing: 'good',
    childrenSuitability: 'ok',
    cartilageSuitability: 'good',
    features: 'neutral',
  },
  inverness: {
    sterility: 'good',
    comfort: 'good',
    healing: 'good',
    childrenSuitability: 'good',
    cartilageSuitability: 'good',
    features: 'neutral',
  },
};

const scoreClasses: Record<Score, string> = {
  good: 'bg-emerald-500',
  ok: 'bg-amber-400',
  bad: 'bg-rose-500',
  neutral: 'bg-muted-foreground/40',
};

const scoreRing: Record<Score, string> = {
  good: 'ring-emerald-500/20',
  ok: 'ring-amber-400/20',
  bad: 'ring-rose-500/20',
  neutral: 'ring-muted-foreground/20',
};

// Method-specific header icon paths
const methodIconPath: Record<Method, string> = {
  // Lightning bolt — fast & forceful
  gun: 'M13 10V3L4 14h7v7l9-11h-7z',
  // Vertical line — needle
  needle: 'M12 2v20M9 5l3-3 3 3M15 19l-3 3-3-3',
  // Sparkle — premium
  inverness: 'M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z',
};
---

{!split ? (
  <section id="comparison" class={`relative ${compact ? 'py-12' : 'py-20'} bg-background border-t border-border overflow-hidden`}>
    <!-- Decorative blobs — consistent with Hero/CTA/About -->
    <div class="absolute inset-0 opacity-[0.06] pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/4 -left-10 w-80 h-80 bg-primary rounded-full blur-3xl" />
      <div class="absolute bottom-10 right-1/4 w-72 h-72 bg-accent rounded-full blur-3xl" />
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Section header -->
      <div class={`text-center ${compact ? 'mb-10' : 'mb-16'} max-w-3xl mx-auto`}>
        <p class="text-xs sm:text-sm font-semibold tracking-[0.2em] uppercase text-primary mb-4">
          Inverness MED · USA
        </p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground mb-4">
          {t(locale, 'comparison.title')}
        </h2>
        {!compact && (
          <>
            <p class="text-lg text-foreground/80 font-medium mb-3">
              {t(locale, 'comparison.subtitle')}
            </p>
            <p class="text-base text-muted-foreground leading-relaxed">
              {t(locale, 'comparison.description')}
            </p>
          </>
        )}
      </div>

      <!-- Video block — softer container, lighter heading -->
      <div class="mb-16 sm:mb-20 flex flex-col items-center">
        <p class="text-xs uppercase tracking-[0.2em] text-muted-foreground mb-3">
          {t(locale, 'comparison.videoSubtitle')}
        </p>
        <div class="relative w-full max-w-3xl aspect-video rounded-2xl overflow-hidden shadow-soft border border-border bg-card">
          <iframe 
            class="absolute top-0 left-0 w-full h-full"
            src="https://www.youtube.com/embed/BgMvG5Lr1Tw?si=Vv2MvcUXRi7ABFOS" 
            title="Inverness Piercing System" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>

      <!-- Comparison table -->
      <div class={`${width} mx-auto`}>
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-6">
          <h3 class="text-2xl sm:text-3xl font-bold text-foreground">
            {t(locale, 'comparison.tableTitle')}
          </h3>

          <!-- Status legend -->
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-muted-foreground">
            <span class="flex items-center gap-1.5">
              <span class="h-2.5 w-2.5 rounded-full bg-emerald-500" aria-hidden="true" />
              {t(locale, 'comparison.legend.good')}
            </span>
            <span class="flex items-center gap-1.5">
              <span class="h-2.5 w-2.5 rounded-full bg-amber-400" aria-hidden="true" />
              {t(locale, 'comparison.legend.ok')}
            </span>
            <span class="flex items-center gap-1.5">
              <span class="h-2.5 w-2.5 rounded-full bg-rose-500" aria-hidden="true" />
              {t(locale, 'comparison.legend.bad')}
            </span>
          </div>
        </div>

        {/* Desktop Table */}
        <div class="hidden lg:block">
          <div class="relative">
            <!-- Floating "Recommended" badge over the Inverness column -->
            <div class="absolute -top-3 right-0 w-1/4 flex justify-center pointer-events-none z-10">
              <span class="inline-flex items-center gap-1.5 bg-primary text-primary-foreground text-[11px] font-bold uppercase tracking-widest px-3 py-1 rounded-full shadow-soft">
                <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                </svg>
                {t(locale, 'comparison.recommended')}
              </span>
            </div>

            <table class="w-full border-collapse">
              <thead>
                <tr>
                  <th class="w-1/4 p-4 text-left text-xs font-semibold uppercase tracking-wider text-muted-foreground border-b border-border">
                    {t(locale, 'comparison.attributes.method')}
                  </th>
                  {methods.map((method) => (
                    <th 
                      key={method}
                      class={`w-1/4 p-4 text-center font-semibold text-foreground border-b ${
                        method === 'inverness' 
                          ? 'bg-primary/[0.04] border-b-primary/20 border-t-4 border-t-primary rounded-t-lg' 
                          : 'border-border'
                      }`}
                    >
                      <div class="flex flex-col items-center gap-2">
                        <span class={`inline-flex items-center justify-center h-9 w-9 rounded-full ${
                          method === 'inverness' 
                            ? 'bg-primary/10 text-primary' 
                            : 'bg-muted text-muted-foreground'
                        }`}>
                          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={methodIconPath[method]} />
                          </svg>
                        </span>
                        <span class={`text-base ${method === 'inverness' ? 'text-primary' : ''}`}>
                          {t(locale, `comparison.methods.${method}.name`)}
                        </span>
                      </div>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {attributes.map((attr, attrIdx) => (
                  <tr key={attr} class={attrIdx % 2 === 1 ? 'bg-muted/30' : ''}>
                    <td class="p-4 align-top text-sm font-semibold text-foreground border-b border-border/60">
                      {t(locale, `comparison.attributes.${attr}`)}
                    </td>
                    {methods.map((method) => {
                      const score = scores[method][attr];
                      return (
                        <td 
                          key={method} 
                          class={`p-4 align-top text-sm border-b border-border/60 ${
                            method === 'inverness' 
                              ? 'bg-primary/[0.04] text-foreground font-medium' 
                              : 'text-muted-foreground'
                          }`}
                        >
                          <div class="flex items-start gap-2.5">
                            <span 
                              class={`mt-1.5 h-2.5 w-2.5 rounded-full flex-shrink-0 ring-4 ${scoreClasses[score]} ${scoreRing[score]}`}
                              aria-hidden="true"
                            />
                            <span class="leading-relaxed">
                              {t(locale, `comparison.methods.${method}.${attr}`)}
                            </span>
                          </div>
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        {/* Mobile: Winner card + Alternatives */}
        <div class="lg:hidden space-y-6">
          <!-- Winner: Inverness -->
          <div class="relative bg-gradient-to-br from-primary-light/50 via-background to-secondary/15 rounded-2xl border-2 border-primary p-6 shadow-soft">
            <span class="absolute -top-3 left-6 inline-flex items-center gap-1.5 bg-primary text-primary-foreground text-[11px] font-bold uppercase tracking-widest px-3 py-1 rounded-full">
              <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
              {t(locale, 'comparison.recommended')}
            </span>
            <div class="flex items-center gap-3 mb-5 mt-1">
              <span class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-primary/10 text-primary">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={methodIconPath.inverness} />
                </svg>
              </span>
              <h4 class="text-xl font-bold text-primary">
                {t(locale, 'comparison.methods.inverness.name')}
              </h4>
            </div>
            <dl class="space-y-3">
              {attributes.map((attr) => {
                const score = scores.inverness[attr];
                return (
                  <div key={attr} class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-0.5">
                    <span 
                      class={`mt-2 h-2.5 w-2.5 rounded-full flex-shrink-0 ring-4 ${scoreClasses[score]} ${scoreRing[score]}`}
                      aria-hidden="true"
                    />
                    <div>
                      <dt class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                        {t(locale, `comparison.attributes.${attr}`)}
                      </dt>
                      <dd class="text-sm text-foreground font-medium">
                        {t(locale, `comparison.methods.inverness.${attr}`)}
                      </dd>
                    </div>
                  </div>
                );
              })}
            </dl>
          </div>

          <!-- Alternatives header -->
          <p class="text-xs uppercase tracking-[0.2em] text-muted-foreground font-semibold pt-2">
            {t(locale, 'comparison.alternatives')}
          </p>

          <!-- Other methods: compact cards -->
          {(['gun', 'needle'] as Method[]).map((method) => (
            <div key={method} class="bg-card rounded-2xl border border-border p-6">
              <div class="flex items-center gap-3 mb-4">
                <span class="inline-flex items-center justify-center h-9 w-9 rounded-full bg-muted text-muted-foreground">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={methodIconPath[method]} />
                  </svg>
                </span>
                <h4 class="text-lg font-bold text-foreground">
                  {t(locale, `comparison.methods.${method}.name`)}
                </h4>
              </div>
              <dl class="space-y-3">
                {attributes.map((attr) => {
                  const score = scores[method][attr];
                  return (
                    <div key={attr} class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-0.5">
                      <span 
                        class={`mt-2 h-2.5 w-2.5 rounded-full flex-shrink-0 ring-4 ${scoreClasses[score]} ${scoreRing[score]}`}
                        aria-hidden="true"
                      />
                      <div>
                        <dt class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                          {t(locale, `comparison.attributes.${attr}`)}
                        </dt>
                        <dd class="text-sm text-foreground/80">
                          {t(locale, `comparison.methods.${method}.${attr}`)}
                        </dd>
                      </div>
                    </div>
                  );
                })}
              </dl>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
) : (
  <>
    <section id="video" class="mb-24">
      <div class="w-full">
        <h2 class="text-2xl sm:text-3xl font-bold text-foreground mb-2 text-center">
          {t(locale, 'comparison.title')}
        </h2>
        <h3 class="text-xl sm:text-2xl font-medium text-muted-foreground mb-8 text-center">
          {t(locale, 'comparison.videoSubtitle')}
        </h3>
        <div class="relative w-full aspect-video rounded-3xl overflow-hidden shadow-xl border border-border bg-card">
          <iframe 
            class="absolute top-0 left-0 w-full h-full"
            src="https://www.youtube.com/embed/BgMvG5Lr1Tw?si=Vv2MvcUXRi7ABFOS" 
            title="Inverness Piercing System" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </section>

    {showTable && <section id="comparison-table" class="mb-24">
      <div class="w-full">
        <h3 class="text-2xl sm:text-3xl font-bold text-foreground mb-8 text-center">
          {t(locale, 'comparison.tableTitle')}
        </h3>
        
        {/* Desktop Table */}
        <div class="hidden lg:block overflow-x-auto">
          <div class="min-w-full border border-border rounded-lg overflow-hidden bg-card">
            <table class="w-full border-collapse">
              <thead>
                <tr class="bg-muted/50">
                  <th class="w-1/4 p-4 text-left font-semibold text-foreground border-b border-border">
                    {t(locale, 'comparison.attributes.method')}
                  </th>
                  <th class="p-4 text-center font-semibold text-foreground border-b border-border">
                    {t(locale, 'comparison.methods.gun.name')}
                  </th>
                  <th class="p-4 text-center font-semibold text-foreground border-b border-border">
                    {t(locale, 'comparison.methods.needle.name')}
                  </th>
                  <th class="p-4 text-center font-semibold text-foreground border-b border-border bg-primary/5 border-l-4 border-primary">
                    <svg class="h-5 w-5 text-primary inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                    </svg>
                    {t(locale, 'comparison.methods.inverness.name')}
                  </th>
                </tr>
              </thead>
              <tbody>
                {attributes.map((attr) => (
                  <tr key={attr} class="hover:bg-muted/30 border-b border-border last:border-b-0">
                    <td class="p-4 font-medium text-foreground">
                      {t(locale, `comparison.attributes.${attr}`)}
                    </td>
                    {methods.map((method) => (
                      <td 
                        key={method} 
                        class={`p-4 text-sm ${method === 'inverness' ? 'bg-primary/5 border-l-4 border-primary font-medium' : ''}`}
                      >
                        {method === 'inverness' ? (
                          <svg class="h-5 w-5 text-primary inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                          </svg>
                        ) : method === 'gun' && ['sterility', 'comfort', 'healing', 'childrenSuitability', 'cartilageSuitability'].includes(attr) ? (
                          <svg class="h-5 w-5 text-destructive inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                          </svg>
                        ) : method === 'needle' && attr === 'cartilageSuitability' ? (
                          <svg class="h-5 w-5 text-primary inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                          </svg>
                        ) : (
                          <svg class="h-5 w-5 text-muted-foreground inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                          </svg>
                        )}
                        {t(locale, `comparison.methods.${method}.${attr}`)}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        {/* Mobile Cards */}
        <div class="lg:hidden space-y-6">
          {methods.map((method) => (
            <div 
              key={method} 
              class={`p-6 bg-card rounded-lg border ${method === 'inverness' ? 'border-2 border-primary bg-primary/5' : 'border-border'}`}
            >
              <h4 class={`text-xl font-bold mb-4 flex items-center ${method === 'inverness' ? 'text-primary' : 'text-foreground'}`}>
                {method === 'inverness' && (
                  <svg class="h-6 w-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                  </svg>
                )}
                {t(locale, `comparison.methods.${method}.name`)}
              </h4>
              <div class="space-y-4">
                {attributes.map((attr) => (
                  <div key={attr}>
                    <p class="font-medium text-foreground mb-1">
                      {t(locale, `comparison.attributes.${attr}`)}
                    </p>
                    <p class="text-sm text-muted-foreground">
                      {t(locale, `comparison.methods.${method}.${attr}`)}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>}
  </>
)}
