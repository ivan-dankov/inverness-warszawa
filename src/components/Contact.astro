---
import { t } from '../lib/translations';
import type { Locale } from '../lib/seo';
import Map from './Map.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section id="contact" class="py-4">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground mb-4">
        {t(locale, 'contact.title')}
      </h1>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
        {t(locale, 'contact.subtitle')}
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      <div class="p-8 bg-card rounded-lg border border-border shadow-card">
        <h3 class="text-2xl font-bold text-foreground mb-6">
          {t(locale, 'contact.contactInfo')}
        </h3>
        
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <svg class="h-6 w-6 text-primary mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <div>
              <h4 class="font-semibold text-foreground mb-1">{t(locale, 'contact.location')}</h4>
              <p class="text-muted-foreground mb-2">
                Ursynowska 10/1<br />
                02-605 Warszawa, Mokotów
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <svg class="h-6 w-6 text-primary mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <div>
              <h4 class="font-semibold text-foreground mb-1">{t(locale, 'contact.phone')}</h4>
              <a href="tel:+48573818260" class="text-primary hover:underline">
                +48 573 818 260
              </a>
              <p class="text-sm text-muted-foreground mt-1">
                {t(locale, 'contact.messengers')}
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <svg class="h-6 w-6 text-primary mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <div>
              <h4 class="font-semibold text-foreground mb-1">{t(locale, 'contact.email')}</h4>
              <a href="mailto:piercinggentle@gmail.com" class="text-primary hover:underline">
                {t(locale, 'contact.emailAddress')}
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <svg class="h-6 w-6 text-primary mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <div>
              <h4 class="font-semibold text-foreground mb-1">{t(locale, 'contact.instagram')}</h4>
              <a href="https://instagram.com/prokol_ushej_warszawa" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                @prokol_ushej_warszawa
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <svg class="h-6 w-6 text-primary mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
              <h4 class="font-semibold text-foreground mb-1">{t(locale, 'contact.hours')}</h4>
              <div class="space-y-1 text-muted-foreground">
                <p><span class="font-medium">{t(locale, 'contact.days')}:</span> 10:00 - 20:00</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-card rounded-lg border border-border shadow-card">
        <Map />
      </div>
    </div>
  </div>
</section>


