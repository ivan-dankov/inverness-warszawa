---
import { t, getTranslations } from '../lib/translations';
import type { Locale } from '../lib/seo';
import { Image } from 'astro:assets';
import imgGun from '../assets/33-595_3_LE_upscale_prime 1.png';
import imgInverness from '../assets/inverness-med_bezpieczne_sterylne_przekluwanie-uszu_chrzastki_gabinet_warszawa_mokotow_martawojtowicz-4_LE_upscale_prime 1.png';
import imgNeedle from '../assets/yhst-27367612611215_2266_183340722__25439_LE_upscale_prime 1.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translations = getTranslations(locale);
const comparison = translations.comparison || {};

type Method = 'gun' | 'needle' | 'inverness';
type Attribute = 'sterility' | 'comfort' | 'healing' | 'childrenSuitability' | 'cartilageSuitability' | 'features';
type Score = 'good' | 'ok' | 'bad' | 'neutral';

const methods: Method[] = ['gun', 'needle', 'inverness'];
const attributes: Attribute[] = ['sterility', 'comfort', 'healing', 'childrenSuitability', 'cartilageSuitability', 'features'];

const scores: Record<Method, Record<Attribute, Score>> = {
  gun: {
    sterility: 'bad',
    comfort: 'bad',
    healing: 'bad',
    childrenSuitability: 'bad',
    cartilageSuitability: 'bad',
    features: 'neutral',
  },
  needle: {
    sterility: 'good',
    comfort: 'ok',
    healing: 'good',
    childrenSuitability: 'ok',
    cartilageSuitability: 'good',
    features: 'neutral',
  },
  inverness: {
    sterility: 'good',
    comfort: 'good',
    healing: 'good',
    childrenSuitability: 'good',
    cartilageSuitability: 'good',
    features: 'neutral',
  },
};

const dotStyle: Record<Score, string> = {
  good: 'bg-emerald-500',
  ok: 'bg-amber-400',
  bad: 'bg-rose-400',
  neutral: 'bg-border',
};

const methodImage = {
  gun: imgGun,
  needle: imgNeedle,
  inverness: imgInverness,
} as const;
---

<section id="comparison" class="py-24 sm:py-32 bg-background border-t border-border">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">

      <div class="text-center mb-12 sm:mb-16">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground mb-4 leading-tight">
          {t(locale, 'comparison.tableTitle')}
        </h2>
        <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
          {t(locale, 'comparison.subtitle')}
        </p>
      </div>

      <!-- 3 method strips -->
      <div class="space-y-5">
        {methods.map((method) => {
          const isInverness = method === 'inverness';
          return (
            <div class={`flex flex-col sm:flex-row rounded-2xl ${isInverness ? 'relative overflow-hidden bg-[hsl(221,43%,18%)] px-8 py-9' : 'border border-border/60 px-8 py-8 opacity-80'}`}>

              {isInverness && (
                <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
                  <div class="absolute -top-10 -left-10 w-56 h-56 bg-primary opacity-40 rounded-full blur-3xl" />
                  <div class="absolute bottom-0 right-1/4 w-40 h-40 bg-secondary opacity-30 rounded-full blur-3xl" />
                </div>
              )}

              <!-- Left: method identity -->
              <div class="relative flex sm:flex-col items-center sm:items-start gap-4 sm:gap-4 mb-6 sm:mb-0 sm:w-52 sm:min-w-[13rem] sm:pr-10">
                <div class={`flex-shrink-0 overflow-hidden rounded-xl border bg-white dark:bg-zinc-100 ${isInverness ? 'border-white/20' : 'border-border'}`} style="width:96px;height:96px;">
                  <Image
                    src={methodImage[method]}
                    alt={t(locale, `comparison.methods.${method}.name`)}
                    width={96}
                    height={96}
                    format="png"
                    quality={90}
                    class="w-full h-full object-contain object-center"
                    loading="lazy"
                  />
                </div>
                <div>
                  {isInverness && (
                    <span class="block mb-1.5 text-[11px] font-bold uppercase tracking-widest text-white/60">
                      {t(locale, 'comparison.recommended')}
                    </span>
                  )}
                  <p class={`text-lg font-bold leading-tight ${isInverness ? 'text-white' : 'text-foreground'}`}>
                    {t(locale, `comparison.methods.${method}.name`)}
                  </p>
                </div>
              </div>

              <!-- Right: attribute list -->
              <div class="relative flex-1 grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-4">
                {attributes.map((attr) => {
                  const score = scores[method][attr];
                  return (
                    <div class="flex items-start gap-3">
                      <span class={`mt-1.5 w-2.5 h-2.5 rounded-full flex-shrink-0 ${dotStyle[score]}`}></span>
                      <p class={`text-base leading-snug ${isInverness ? 'text-white/80' : 'text-foreground'}`}>
                        {t(locale, `comparison.methods.${method}.${attr}`)}
                      </p>
                    </div>
                  );
                })}
              </div>

            </div>
          );
        })}
      </div>

    </div>
  </div>
</section>
