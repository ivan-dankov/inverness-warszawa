---
import LanguageSwitchReact from './LanguageSwitch';
import type { Locale } from '../lib/seo';

interface Props {
  locale: Locale;
  currentPath: string;
  translationSlugs?: Record<Locale, string>;
}

const { locale, currentPath, translationSlugs } = Astro.props;
---

<LanguageSwitchReact 
  client:load
  currentLocale={locale}
  currentPath={currentPath}
  translationSlugs={translationSlugs}
/>

