---
import { t } from '../lib/translations';
import type { Locale } from '../lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

function getBooksyUrl(locale: Locale): string {
  const baseUrl = 'https://booksy.com/pl-pl/dl/show-business/319418';
  const utmParams = new URLSearchParams({
    utm_source: 'homepage',
    utm_medium: 'cta',
    utm_campaign: `homepage_cta_${locale}`,
  });
  return `${baseUrl}?${utmParams.toString()}`;
}

const booksyUrl = getBooksyUrl(locale);
---

<section id="cta" class="py-20 bg-slate-900 text-white border-t border-slate-800">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4 sm:mb-6">
        {t(locale, 'cta.title')}
      </h2>
      <p class="text-lg sm:text-xl text-slate-200 mb-8 sm:mb-10 max-w-2xl mx-auto leading-relaxed">
        {t(locale, 'cta.subtitle')}
      </p>
      
      <div class="flex flex-col items-center gap-3 mb-8">
        <a 
          href={booksyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary text-primary-foreground font-bold text-base h-14 px-10 hover:bg-primary/90 hover:scale-[1.02] active:scale-[0.98] transition-all shadow-lg w-full sm:w-auto"
          id="homepage-cta-booking-link"
        >
          {t(locale, 'cta.button')}
        </a>
        <a 
          href="tel:+48573818260"
          class="inline-flex items-center justify-center gap-2 text-sm font-medium text-white/60 hover:text-white transition-colors py-1"
        >
          <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {locale === 'pl' ? 'Zadzwoń do nas' : 
           locale === 'en' ? 'Call us' : 
           locale === 'uk' ? 'Подзвонити нам' : 
           'Позвонить нам'}
        </a>
      </div>
      
      <p class="text-sm text-slate-300">
        {t(locale, 'cta.footer')}
      </p>
    </div>
  </div>
</section>

<script define:vars={{ locale }}>
  // Google Analytics - Track booking link click
  const homepageCtaLink = document.getElementById('homepage-cta-booking-link');
  if (homepageCtaLink && window.gtag) {
    homepageCtaLink.addEventListener('click', () => {
      gtag('event', 'booking_click_code', {
        button_location: 'homepage_cta',
        locale: locale,
        booking_platform: 'booksy'
      });
    });
  }
</script>

