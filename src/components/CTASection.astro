---
import { t } from '../lib/translations';
import type { Locale } from '../lib/seo';

interface Props {
  locale: Locale;
  utmSource?: string;
  utmCampaign?: string;
  buttonLocation?: string;
}

const {
  locale,
  utmSource = 'homepage',
  utmCampaign = `homepage_cta_${locale}`,
  buttonLocation = 'homepage_cta',
} = Astro.props;

const booksyUrl = (() => {
  const params = new URLSearchParams({
    utm_source: utmSource,
    utm_medium: 'cta',
    utm_campaign: utmCampaign,
  });
  return `https://booksy.com/pl-pl/dl/show-business/319418?${params.toString()}`;
})();
---

<section class="relative py-16 sm:py-20 bg-[hsl(221,43%,18%)] overflow-hidden">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute -top-10 right-1/4 w-80 h-80 bg-primary opacity-40 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-1/4 w-72 h-72 bg-secondary opacity-30 rounded-full blur-3xl"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
        {t(locale, 'cta.title')}
      </h2>
      <p class="text-lg text-white/70 mb-8 leading-relaxed">
        {t(locale, 'cta.subtitle')}
      </p>

      <div class="flex flex-col sm:flex-row sm:items-center justify-center gap-4">
        <a
          href={booksyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-cta"
          data-cta-track={buttonLocation}
        >
          {t(locale, 'cta.button')}
        </a>
        <span class="text-sm text-white/60">
          {t(locale, 'cta.callPrefix')}
          <a href="tel:+48573818260" class="text-white font-semibold hover:underline ml-1">+48 573 818 260</a>
        </span>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ locale, buttonLocation }}>
  document.querySelectorAll(`[data-cta-track="${buttonLocation}"]`).forEach((link) => {
    link.addEventListener('click', () => {
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'booking_click_code', {
          button_location: buttonLocation,
          locale: locale,
          booking_platform: 'booksy',
        });
      }
    });
  });
</script>
