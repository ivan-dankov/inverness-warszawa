---
import { t } from '../lib/translations';
import type { Locale } from '../lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

function getBooksyUrl(locale: Locale): string {
  const baseUrl = 'https://booksy.com/pl-pl/dl/show-business/319418';
  const utmParams = new URLSearchParams({
    utm_source: 'homepage',
    utm_medium: 'cta',
    utm_campaign: `homepage_cta_${locale}`,
  });
  return `${baseUrl}?${utmParams.toString()}`;
}

const booksyUrl = getBooksyUrl(locale);
---

<section id="cta" class="relative py-20 bg-[hsl(221,43%,18%)] overflow-hidden">
  <!-- Decorative blobs — consistent with Hero -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute -top-10 right-1/4 w-80 h-80 bg-primary opacity-40 rounded-full blur-3xl" />
    <div class="absolute bottom-0 left-1/4 w-72 h-72 bg-secondary opacity-30 rounded-full blur-3xl" />
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4">
        {t(locale, 'cta.title')}
      </h2>

      <!-- Reused 5-star social proof -->
      <div class="flex items-center justify-center gap-2 mb-5">
        {[...Array(5)].map(() => (
          <svg class="h-4 w-4 fill-yellow-400 text-yellow-400 flex-shrink-0" viewBox="0 0 24 24">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
        ))}
        <span class="ml-1 text-sm font-semibold text-white">5.0</span>
        <span class="text-sm text-white/60">
          · {locale === 'pl' ? '200+ opinii na Booksy i Google' :
             locale === 'en' ? '200+ reviews on Booksy & Google' :
             locale === 'uk' ? '200+ відгуків на Booksy і Google' :
             '200+ отзывов на Booksy и Google'}
        </span>
      </div>

      <p class="text-lg text-white/70 mb-8 leading-relaxed max-w-2xl mx-auto">
        {t(locale, 'cta.subtitle')}
      </p>

      <!-- Inline booking button + phone -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-center gap-4">
        <a 
          href={booksyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary text-primary-foreground font-bold text-base h-14 px-10 hover:bg-primary/90 hover:scale-[1.02] active:scale-[0.98] transition-all shadow-soft w-full sm:w-auto"
          id="homepage-cta-booking-link"
        >
          {t(locale, 'cta.button')}
        </a>
        <span class="text-sm text-white/60">
          {t(locale, 'cta.callPrefix')}
          <a href="tel:+48573818260" class="text-white font-semibold hover:text-white/80 hover:underline ml-1">+48 573 818 260</a>
        </span>
      </div>

      <!-- Reassurance overline -->
      <p class="mt-8 text-xs uppercase tracking-[0.2em] text-white/40">
        {t(locale, 'cta.footer')}
      </p>
    </div>
  </div>
</section>


<script define:vars={{ locale }}>
  // Google Analytics - Track booking link click
  const homepageCtaLink = document.getElementById('homepage-cta-booking-link');
  if (homepageCtaLink && window.gtag) {
    homepageCtaLink.addEventListener('click', () => {
      gtag('event', 'booking_click_code', {
        button_location: 'homepage_cta',
        locale: locale,
        booking_platform: 'booksy'
      });
    });
  }
</script>
