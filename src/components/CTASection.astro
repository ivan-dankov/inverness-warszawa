---
import { t } from '../lib/translations';
import type { Locale } from '../lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

function getBooksyUrl(locale: Locale): string {
  const baseUrl = 'https://booksy.com/pl-pl/dl/show-business/319418';
  const utmParams = new URLSearchParams({
    utm_source: 'homepage',
    utm_medium: 'cta',
    utm_campaign: `homepage_cta_${locale}`,
  });
  return `${baseUrl}?${utmParams.toString()}`;
}

const booksyUrl = getBooksyUrl(locale);
---

<section id="cta" class="py-20 bg-slate-900 text-white border-t border-slate-800">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4 sm:mb-6">
        {t(locale, 'cta.title')}
      </h2>
      <p class="text-lg sm:text-xl text-slate-200 mb-8 sm:mb-10 max-w-2xl mx-auto leading-relaxed">
        {t(locale, 'cta.subtitle')}
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-8">
        <a 
          href={booksyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-semibold bg-gradient-to-r from-primary to-primary/90 text-primary-foreground hover:shadow-card transition-shadow duration-300 h-14 px-8 text-base w-full sm:w-auto shadow-lg hover:shadow-xl"
          id="homepage-cta-booking-link"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          {t(locale, 'cta.button')}
        </a>
        <a 
          href="tel:+48573818260"
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-semibold shadow-lg hover:shadow-xl transition-all duration-300 h-14 px-8 text-base w-full sm:w-auto bg-[#F9D9E5] text-[#68253E] hover:bg-[#F5C9D9]"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {t(locale, 'cta.phone')}: +48 573 818 260
        </a>
      </div>
      
      <p class="text-sm text-slate-300">
        {t(locale, 'cta.footer')}
      </p>
    </div>
  </div>
</section>

<script define:vars={{ locale }}>
  // Google Analytics - Track booking link click
  const homepageCtaLink = document.getElementById('homepage-cta-booking-link');
  if (homepageCtaLink && window.gtag) {
    homepageCtaLink.addEventListener('click', () => {
      gtag('event', 'booking_click_code', {
        button_location: 'homepage_cta',
        locale: locale,
        booking_platform: 'booksy'
      });
    });
  }
</script>

