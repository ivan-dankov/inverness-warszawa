---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationPage from './LocationPage.astro';
import {
  getBreadcrumbSchema,
  getFAQSchema,
  getLocalBusinessSchema,
  getServiceSchema,
  getCanonicalUrl,
  type Locale,
} from '../lib/seo';
import { t } from '../lib/translations';
import { siteMetadata } from '../config/seo';
import {
  getLocationHreflang,
  getLocationUrl,
  getLocationsHubUrl,
  type LocationData,
} from '../data/locations';

interface Props {
  locale: Locale;
  location: LocationData;
}

const { locale, location } = Astro.props;
const content = location.content[locale];
const canonical = getLocationUrl(location.slug, locale);

const seo = {
  title: content.seoTitle,
  description: content.seoDescription,
  canonical,
  // Every one of these four URLs is a real page, so the group is legitimate.
  hreflang: getLocationHreflang(location.slug),
  ogImage: siteMetadata.defaultOgImage,
};

const localBusiness = await getLocalBusinessSchema(locale);
const serviceSchema = await getServiceSchema(
  locale,
  content.h1,
  content.h1,
  '90 zł',
  canonical
);

if (location.type === 'district') {
  serviceSchema.areaServed = {
    '@type': 'AdministrativeArea',
    name: content.name,
    containedInPlace: { '@type': 'City', name: 'Warszawa' },
  };
} else {
  serviceSchema.areaServed = {
    '@type': 'City',
    name: content.name,
  };
}

const structuredData = [
  localBusiness,
  serviceSchema,
  getBreadcrumbSchema([
    { name: t(locale, 'breadcrumb.home'), url: getCanonicalUrl(locale, '') },
    { name: t(locale, 'locations.hub.breadcrumb'), url: getLocationsHubUrl(locale) },
    { name: content.name, url: canonical },
  ]),
  getFAQSchema(locale, content.faq),
].filter(Boolean);
---

<BaseLayout locale={locale} seo={seo} structuredData={structuredData}>
  <LocationPage locale={locale} location={location} />
</BaseLayout>
