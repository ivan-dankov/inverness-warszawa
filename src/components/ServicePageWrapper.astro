---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServicePage from './ServicePage.astro';
import { 
  getServicePageSEO, 
  getServicePageHreflang, 
  getServicePageUrl,
  getLocalBusinessSchema,
  getServiceSchema,
  getBreadcrumbSchema,
  getFAQSchema,
  getCanonicalUrl,
  getServiceSlugForLocale,
  getLocalizedPageUrl,
  SERVICE_SLUGS,
  type Locale,
  type ServicePageSlug
} from '../lib/seo';
import { getTranslations, t } from '../lib/translations';
import { siteMetadata } from '../config/seo';

interface Props {
  locale: Locale;
  serviceSlug: ServicePageSlug;
  relatedServices?: ServicePageSlug[];
  seo?: any;
  schema?: any[];
}

const { locale, serviceSlug, relatedServices = [], seo: customSeo, schema: customSchema } = Astro.props;

const translations = getTranslations(locale);

// Get the localized translation key (e.g., 'ear-piercing-warsaw' for English)
const translationKey = getServiceSlugForLocale(serviceSlug, locale);

const serviceData = translations.servicePages?.[translationKey] || translations.servicePages?.[serviceSlug];

if (!serviceData) {
  // Fallback to Polish if translation doesn't exist
  if (locale !== 'pl') {
    const polishSlug = SERVICE_SLUGS[serviceSlug]['pl'];
    return Astro.redirect(`/pl/${polishSlug}`, 302);
  }
  return Astro.redirect(`/${locale}`, 301);
}

const canonical = getServicePageUrl(serviceSlug, locale);
const hreflang = getServicePageHreflang(serviceSlug);

const seo = customSeo || {
  ...getServicePageSEO(locale, serviceSlug),
  canonical,
  hreflang,
  ogImage: siteMetadata.defaultOgImage,
};

const localBusinessSchema = await getLocalBusinessSchema(locale);
const serviceSchema = await getServiceSchema(
  locale,
  serviceData.h1,
  serviceData.serviceType || serviceData.h1,
  serviceData.pricing?.basePrice || '90 zł',
  canonical,
  serviceData.pricing?.additionalInfo
);

const breadcrumbSchema = getBreadcrumbSchema([
  { name: t(locale, 'breadcrumb.home'), url: getCanonicalUrl(locale, '') },
  { name: t(locale, 'header.nav.services'), url: getLocalizedPageUrl('services', locale) },
  { name: serviceData.h1, url: canonical },
]);

// FAQ schema uses the same array ServicePage renders — never a shorter hardcoded set
const faqSchema = serviceData.faq && serviceData.faq.length > 0
  ? getFAQSchema(locale, serviceData.faq)
  : null;

const generatedTypes = new Set(['LocalBusiness', 'Service', 'BreadcrumbList', 'FAQPage']);
const extraSchema = (customSchema || []).filter((node: { '@type'?: string }) => {
  const type = node?.['@type'];
  return Boolean(type) && !generatedTypes.has(type);
});

const structuredData = [
  localBusinessSchema,
  serviceSchema,
  breadcrumbSchema,
  ...(faqSchema ? [faqSchema] : []),
  ...extraSchema,
];
---

<BaseLayout locale={locale} seo={seo} structuredData={structuredData}>
  <ServicePage 
    locale={locale}
    serviceSlug={serviceSlug}
    h1={serviceData.h1}
    content={{
      description: serviceData.description,
      blogLink: serviceData.blogLink,
      features: serviceData.features,
      pricing: serviceData.pricing,
      faq: serviceData.faq,
      visit: serviceData.visit,
    }}
    relatedServices={relatedServices}
  />
</BaseLayout>
