---
import { t } from '../lib/translations';
import { languages } from '../lib/language-routes';
import { PAGE_SLUGS, type Locale } from '../lib/seo';
import logomark from '../assets/logomark.svg';
import Booking from './Booking.astro';

interface Props {
  locale: Locale;
  currentPath?: string;
}

const { locale, currentPath = '' } = Astro.props;
const isHomepage = currentPath === `/${locale}` || currentPath === `/${locale}/`;

// Get localized page slugs
const servicesSlug = PAGE_SLUGS.services[locale];
const contactSlug = PAGE_SLUGS.contact[locale];
const aftercareSlug = PAGE_SLUGS.aftercare[locale];
---

<header class="sticky top-0 z-50 w-full border-b border-border/40 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <a href={`/${locale}`} class="cursor-pointer">
        <img 
          src={logomark.src || logomark}
          alt="Inverness MED" 
          class="h-12 w-auto" 
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="200"
          height="48"
        />
      </a>

      <nav class="hidden lg:flex items-center gap-8">
        <a
          href={`/${locale}`}
          class={`text-sm font-medium transition-colors ${isHomepage ? 'text-primary' : 'text-muted-foreground hover:text-primary'}`}
        >
          {t(locale, 'header.nav.home')}
        </a>
        <a
          href={`/${locale}/${servicesSlug}`}
          class={`text-sm font-medium transition-colors ${currentPath.includes(`/${servicesSlug}`) ? 'text-primary' : 'text-muted-foreground hover:text-primary'}`}
        >
          {t(locale, 'header.nav.services')}
        </a>
        <a
          href={`/${locale}/${aftercareSlug}`}
          class={`text-sm font-medium transition-colors ${currentPath.includes(`/${aftercareSlug}`) ? 'text-primary' : 'text-muted-foreground hover:text-primary'}`}
        >
          {t(locale, 'header.nav.aftercare')}
        </a>
        <a 
          href={`/${locale}/blog`}
          class={`text-sm font-medium transition-colors ${currentPath.includes('/blog') ? 'text-primary' : 'text-muted-foreground hover:text-primary'}`}
        >
          {t(locale, 'header.nav.blog')}
        </a>
        <a
          href={`/${locale}/${contactSlug}`}
          class={`text-sm font-medium transition-colors ${currentPath.includes(`/${contactSlug}`) ? 'text-primary' : 'text-muted-foreground hover:text-primary'}`}
        >
          {t(locale, 'header.nav.contact')}
        </a>
      </nav>

      <div class="flex items-center gap-2">
        <div class="hidden lg:flex items-center gap-2">
          <slot name="language-switch" />
          <a href="tel:+48573818260" class="text-muted-foreground hover:text-primary transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </a>
          <a href="https://instagram.com/prokol_ushej_warszawa" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-primary transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>
        
        <Booking
          variant="nav"
          locale={locale}
          utmCampaign={`${locale}_header`}
          buttonLocation="header"
        />

        <button 
          id="mobile-menu-button"
          class="lg:hidden min-w-[44px] min-h-[44px] inline-flex items-center justify-center rounded-md border border-input bg-background hover:bg-accent hover:text-accent-foreground"
          aria-label="Menu"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-border bg-background">
    <div class="container mx-auto px-4 py-4 space-y-4">
      <a
        href={`/${locale}`}
        class={`block text-base font-medium transition-colors ${isHomepage ? 'text-primary' : 'text-muted-foreground hover:text-primary'}`}
      >
        {t(locale, 'header.nav.home')}
      </a>
      <a
        href={`/${locale}/${servicesSlug}`}
        class={`block text-base font-medium transition-colors ${currentPath.includes(`/${servicesSlug}`) ? 'text-primary' : 'text-muted-foreground hover:text-primary'}`}
      >
        {t(locale, 'header.nav.services')}
      </a>
      <a href={`/${locale}/${aftercareSlug}`} class={`block text-base font-medium transition-colors ${currentPath.includes(`/${aftercareSlug}`) ? 'text-primary' : 'text-muted-foreground hover:text-primary'}`}>
        {t(locale, 'header.nav.aftercare')}
      </a>
      <a href={`/${locale}/blog`} class={`block text-base font-medium transition-colors ${currentPath.includes('/blog') ? 'text-primary' : 'text-muted-foreground hover:text-primary'}`}>
        {t(locale, 'header.nav.blog')}
      </a>
      <a
        href={`/${locale}/${contactSlug}`}
        class={`block text-base font-medium transition-colors ${currentPath.includes(`/${contactSlug}`) ? 'text-primary' : 'text-muted-foreground hover:text-primary'}`}
      >
        {t(locale, 'header.nav.contact')}
      </a>
      
      <div class="border-t pt-4 mt-4 flex flex-col gap-4">
        <div class="flex items-center gap-2">
          <slot name="language-switch" />
        </div>
        <a href="tel:+48573818260" class="flex items-center gap-3 text-muted-foreground hover:text-primary transition-colors">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>+48 573 818 260</span>
        </a>
        <a href="https://instagram.com/prokol_ushej_warszawa" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-muted-foreground hover:text-primary transition-colors">
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span>Instagram</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  if (menuButton && mobileMenu) {
    menuButton.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>

