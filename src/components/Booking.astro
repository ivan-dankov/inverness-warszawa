---
import { t } from '../lib/translations';
import type { Locale } from '../lib/seo';
import { getBooksyUrl, STUDIO_PHONE, STUDIO_PHONE_HREF } from '../lib/booksy';

export interface PriceEntry {
  label: string;
  value: string;
}

interface Props {
  variant?: 'band' | 'inline' | 'nav';
  locale: Locale;
  utmSource?: string;
  utmCampaign?: string;
  buttonLocation: string;
  title?: string | null;
  subtitle?: string | null;
  prices?: string | PriceEntry[];
  priceNote?: string;
  showPhone?: boolean;
  tone?: 'onDark' | 'onLight';
  align?: 'start' | 'center';
  class?: string;
}

const {
  variant = 'band',
  locale,
  utmSource = 'homepage',
  utmCampaign = `homepage_cta_${locale}`,
  buttonLocation,
  title,
  subtitle,
  prices,
  priceNote,
  showPhone = variant !== 'nav',
  tone = variant === 'band' ? 'onDark' : 'onLight',
  align = 'start',
  class: className = '',
} = Astro.props;

const booksyUrl = getBooksyUrl({ source: utmSource, campaign: utmCampaign });
const label = t(locale, 'cta.button');

// `basePrice` copy is authored either as a single price or as "label: value, label: value".
const priceEntries: PriceEntry[] =
  typeof prices === 'string'
    ? prices.includes(',')
      ? prices.split(',').map((part) => {
          const [entryLabel, entryValue] = part.split(':');
          return { label: entryLabel.trim(), value: entryValue?.trim() || '' };
        })
      : []
    : (prices ?? []);

const singlePrice = typeof prices === 'string' && priceEntries.length === 0 ? prices : null;
const hasPrices = priceEntries.length > 0 || Boolean(singlePrice);

const headingText = title === undefined ? t(locale, 'cta.title') : title;
const subtitleText = subtitle === undefined ? t(locale, 'cta.subtitle') : subtitle;

const onDark = tone === 'onDark';
const mutedClass = onDark ? 'text-white/60' : 'text-muted-foreground';
const phoneLinkClass = onDark ? 'text-white' : 'text-foreground';
const priceClass = onDark ? 'text-white' : 'text-primary';
---

{variant === 'band' && (
  <section class:list={['relative py-16 sm:py-20 bg-[hsl(221,43%,18%)] overflow-hidden', className]}>
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute -top-10 right-1/4 w-80 h-80 bg-primary opacity-40 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-1/4 w-72 h-72 bg-secondary opacity-30 rounded-full blur-3xl"></div>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-2xl mx-auto text-center">
        {headingText && (
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">{headingText}</h2>
        )}
        {subtitleText && (
          <p class="text-lg text-white/70 mb-8 leading-relaxed">{subtitleText}</p>
        )}

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={booksyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-cta"
            data-booking-cta={buttonLocation}
            data-booking-locale={locale}
          >
            {label}
          </a>
          {showPhone && (
            <span class="text-sm text-white/60 text-center">
              {t(locale, 'cta.callPrefix')}
              <a href={STUDIO_PHONE_HREF} class="text-white font-semibold hover:underline ml-1">
                {STUDIO_PHONE}
              </a>
            </span>
          )}
        </div>
      </div>
    </div>
  </section>
)}

{variant === 'inline' && (
  <div class:list={[align === 'center' && 'text-center', className]}>
    {hasPrices && (
      <div class:list={['mb-7', align === 'center' && 'flex flex-col items-center']}>
        {singlePrice && (
          <>
            <p class={`text-sm ${mutedClass} mb-2`}>{t(locale, 'cta.priceLabel')}</p>
            <p class={`text-2xl sm:text-3xl font-bold ${priceClass} tracking-tight leading-snug`}>
              {singlePrice}
            </p>
          </>
        )}
        {priceEntries.length > 0 && (
          <dl class:list={['flex flex-wrap items-baseline gap-x-8 gap-y-3', align === 'center' && 'justify-center']}>
            {priceEntries.map((price) => (
              <div>
                <dt class={`text-sm ${mutedClass} mb-1`}>{price.label}</dt>
                <dd class={`text-2xl sm:text-3xl font-bold ${priceClass} tracking-tight leading-none`}>
                  {price.value}
                </dd>
              </div>
            ))}
          </dl>
        )}
        {priceNote && (
          <p class:list={['mt-4 text-sm', mutedClass, 'max-w-[48ch]', align === 'center' && 'mx-auto']}>
            {priceNote}
          </p>
        )}
      </div>
    )}

    <div class:list={['flex flex-col sm:flex-row gap-4', align === 'center' ? 'items-center justify-center' : 'sm:items-center']}>
      <a
        href={booksyUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-cta"
        data-booking-cta={buttonLocation}
        data-booking-locale={locale}
      >
        {label}
      </a>
      {showPhone && (
        <span class:list={['text-sm', mutedClass, align === 'center' && 'text-center']}>
          {t(locale, 'cta.callPrefix')}
          <a href={STUDIO_PHONE_HREF} class={`${phoneLinkClass} font-semibold hover:underline ml-1`}>
            {STUDIO_PHONE}
          </a>
        </span>
      )}
    </div>
  </div>
)}

{variant === 'nav' && (
  <a
    href={booksyUrl}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[
      'inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-lg bg-primary text-primary-foreground font-bold text-sm h-11 px-4 hover:bg-primary/90 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2',
      className,
    ]}
    data-booking-cta={buttonLocation}
    data-booking-locale={locale}
  >
    {label}
  </a>
)}

<script>
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const link = target.closest('[data-booking-cta]');
    if (!(link instanceof HTMLElement) || typeof window.gtag !== 'function') return;

    window.gtag('event', 'booking_click_code', {
      button_location: link.dataset.bookingCta,
      locale: link.dataset.bookingLocale,
      booking_platform: 'booksy',
    });
  });
</script>
