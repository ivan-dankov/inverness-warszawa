    service: "Przekłuwanie uszu dzieciom 0+ INVERNESS MED"
  },
  {
    name: "Olena W.",
    date: "2025-12-08",
    rating: 5,
    text: "Polecam serdecznie 10/10",
    service: "Przekłucie płatka ucha INVERNESS MED"
  },
  {
    name: "Maria P.",
    date: "2025-12-05",
