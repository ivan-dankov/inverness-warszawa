    service: "Konsultacja przed przekłuciem"
  },
  {
    name: "Katarzyna L.",
    date: "2025-12-03",
    rating: 5,
    text: "Przekłuwaliśmy uszy naszej 7-letniej córce. Bardzo polecam! Sterylnie, czysto i bezboleśnie. Uszy pięknie zagoiły się od razu! Polecam!!! ❤️",
    service: "Przekłuwanie uszu dzieciom 0+ INVERNESS MED"
