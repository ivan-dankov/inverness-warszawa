---
import { t } from '../lib/translations';
import type { Locale } from '../lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section id="comparison-video" class="py-16 sm:py-20 bg-background-alt border-t border-border">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center max-w-6xl mx-auto">

      <!-- Left: text -->
      <div class="text-center lg:text-left">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground mb-4 leading-tight">
          {t(locale, 'comparison.title')}
        </h2>
        <p class="text-lg text-muted-foreground leading-relaxed">
          {t(locale, 'comparison.description')}
        </p>
      </div>

      <!-- Right: video -->
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-muted-foreground mb-3">
          {t(locale, 'comparison.videoSubtitle')}
        </p>
        <div class="relative w-full aspect-video rounded-2xl overflow-hidden shadow-soft border border-border bg-card">
          <iframe
            class="absolute top-0 left-0 w-full h-full"
            src="https://www.youtube.com/embed/BgMvG5Lr1Tw?si=Vv2MvcUXRi7ABFOS"
            title="Inverness Piercing System"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>

    </div>
  </div>
</section>
