---
import { t } from '../lib/translations';
import type { Locale } from '../lib/seo';
import { Gallery as GalleryReact } from './Gallery.tsx';
import { getImage } from 'astro:assets';

// Import images dynamically based on folder structure
const allImages = import.meta.glob('../assets/gallery/**/*.{jpeg,jpg,png,webp}', { eager: true });

// Hard-coded random order for Home Page (all 30 images)
const homePageOrder = [
  '../assets/gallery/children/image-05.jpeg',
  '../assets/gallery/adults/image-15.jpeg',
  '../assets/gallery/cartilage/image-25.jpeg',
  '../assets/gallery/children/image-01.jpeg',
  '../assets/gallery/adults/image-11.jpeg',
  '../assets/gallery/cartilage/image-21.jpeg',
  '../assets/gallery/children/image-09.jpeg',
  '../assets/gallery/adults/image-19.jpeg',
  '../assets/gallery/cartilage/image-29.jpeg',
  '../assets/gallery/children/image-03.jpeg',
  '../assets/gallery/adults/image-13.jpeg',
  '../assets/gallery/cartilage/image-23.jpeg',
  '../assets/gallery/children/image-07.jpeg',
  '../assets/gallery/adults/image-17.jpeg',
  '../assets/gallery/cartilage/image-27.jpeg',
  '../assets/gallery/children/image-02.jpeg',
  '../assets/gallery/adults/image-12.jpeg',
  '../assets/gallery/cartilage/image-22.jpeg',
  '../assets/gallery/children/image-08.jpeg',
  '../assets/gallery/adults/image-18.jpeg',
  '../assets/gallery/cartilage/image-28.jpeg',
  '../assets/gallery/children/image-04.jpeg',
  '../assets/gallery/adults/image-14.jpeg',
  '../assets/gallery/cartilage/image-24.jpeg',
  '../assets/gallery/children/image-06.jpeg',
  '../assets/gallery/adults/image-16.jpeg',
  '../assets/gallery/cartilage/image-26.jpeg',
  '../assets/gallery/children/image-10.jpeg',
  '../assets/gallery/adults/image-20.jpeg',
  '../assets/gallery/cartilage/image-30.jpeg',
];

interface Props {
  locale: Locale;
  folder?: 'children' | 'adults' | 'cartilage' | string;
  count?: number;
}

const { locale, folder, count = 18 } = Astro.props;

let rawImages = [];

if (folder) {
  // Filter by folder
  rawImages = Object.entries(allImages).filter(([path]) => path.includes(`/${folder}/`));
} else {
  // Use hard-coded order for Home Page
  rawImages = homePageOrder.map(path => {
    const entry = Object.entries(allImages).find(([p]) => p === path);
    return entry ? entry : null;
  }).filter(Boolean) as [string, any][];
}

const filteredImages = rawImages.map(([path, img]: any) => {
  // Generate alt text based on folder or default
  let alt = "Przekłuwanie uszu Warszawa - Gentle Piercing";
  if (path.includes('/children/')) alt = "Przekłuwanie uszu dzieciom Warszawa - Gentle Piercing";
  if (path.includes('/adults/')) alt = "Przekłuwanie uszu dla dorosłych - Gentle Piercing";
  if (path.includes('/cartilage/')) alt = "Przekłuwanie chrząstki (Helix, Conch, Tragus) - Gentle Piercing";
  
  return {
    img: img.default,
    alt
  };
});

// If folder is specified, limit by count (default 18).
// If NO folder (Home Page), show ALL images (ignore count or set high).
const imagesToDisplay = folder ? filteredImages.slice(0, count) : filteredImages;

// Optimize images: thumbnails (400x400) and full-size (1200px width, WebP format)
const optimizeImage = async (img: any) => {
  const thumb = await getImage({
    src: img,
    width: 400,
    height: 400,
    format: 'webp',
    quality: 80,
  });
  
  const full = await getImage({
    src: img,
    width: 1200,
    format: 'webp',
    quality: 85,
  });
  
  return {
    thumb: thumb.src,
    full: full.src,
  };
};

// Optimize all selected images
const galleryImages = await Promise.all(imagesToDisplay.map(async ({ img, alt }) => {
  const optimized = await optimizeImage(img);
  return {
    thumb: optimized.thumb,
    full: optimized.full,
    alt,
  };
}));
---

<GalleryReact client:load locale={locale} images={galleryImages} />
