{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.gentlepiercing.pl" }],
      "destination": "https://gentlepiercing.pl/pl",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.gentlepiercing.pl" }],
      "destination": "https://gentlepiercing.pl/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/pl",
      "permanent": true
    },
    {
      "source": "/pl/przekluwanie-uszu-warszawa",
      "destination": "/pl",
      "permanent": true
    },
    {
      "source": "/pl/uszy-dzieciom-warszawa",
      "destination": "/pl/uslugi/przekluwanie-uszu-dzieci-warszawa",
      "permanent": true
    },
    {
      "source": "/pl/przekluwanie-uszu-dorosli-warszawa",
      "destination": "/pl/uslugi/przekluwanie-uszu-dorosli-warszawa",
      "permanent": true
    },
    {
      "source": "/pl/przekluwanie-chrzastki-warszawa",
      "destination": "/pl/uslugi/przekluwanie-chrzastki-warszawa",
      "permanent": true
    },
    {
      "source": "/pl/przekluwanie-uszu-z-dojazdem-warszawa",
      "destination": "/pl/uslugi/przekluwanie-uszu-z-dojazdem-warszawa",
      "permanent": true
    },
    {
      "source": "/uk/blog/doglyad-za-vukhamy-pislya-prokolu",
      "destination": "/uk/blog/doglyad-za-vukhami-pislya-prokolu-povnii-gid-2026",
      "permanent": true
    },
    {
      "source": "/uk/blog/%D0%BF%D1%80%D0%BE%D0%BA%D0%BE%D0%BB-%D0%B2%D1%83%D1%85-%D1%86%D0%B5-%D0%B1%D0%BE%D0%BB%D1%8F%D1%87%D0%B5",
      "destination": "/uk/blog/chy-bolyt-prokol-vukh",
      "permanent": true
    },
    {
      "source": "/:path*/",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { 
      "source": "/api/decap-proxy/(.*)", 
      "destination": "/api/decap-proxy"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/assets/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/@imagetools/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(jpg|jpeg|png|webp|svg|gif|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
