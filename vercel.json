{
  "buildCommand": "",
  "outputDirectory": "dist",
  "rewrites": [
    { 
      "source": "/api/decap-proxy/(.*)", 
      "destination": "/api/decap-proxy"
    },
    { 
      "source": "/(.*)", 
      "destination": "/index.html" 
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
