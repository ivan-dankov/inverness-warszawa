{
  "buildCommand": "",
  "outputDirectory": "dist",
  "rewrites": [
    { 
      "source": "/api/decap-proxy/(.*)", 
      "destination": "/api/decap-proxy"
    },
    {
      "source": "/((?!admin/).*)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "text/html.*"
        }
      ],
      "destination": "/index.html"
    },
    { 
      "source": "/:path((?!.*\\.).*)", 
      "destination": "/index.html" 
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
